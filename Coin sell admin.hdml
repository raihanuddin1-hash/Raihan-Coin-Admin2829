  'free fire':'🔥','freefire':'🔥','ff':'🔥',
  'pubg':'🎮','uc':'🎮','mobile legends':'⚔️','mlbb':'⚔️','genshin':'✨',
  'netflix':'📺','spotify':'🎵','youtube':'▶️','diamond':'💎',
  'top up':'💰','topup':'💰','imo':'💬','whatsapp':'💬','telegram':'✈️',
  'prime':'🎬','movie':'🎬','game':'🎮'
};

/* =========================================================
   HELPERS
========================================================= */
function $(id){ return document.getElementById(id); }
function num(v){ return Number(String(v).replace(/[^0-9.]/g,'')) || 0; }
function fmt(n){ return Number(n||0).toLocaleString('en-IN'); }
function fmtD(n){ const v=Number(n||0); return Number.isInteger(v)?v.toLocaleString('en-IN'):v.toFixed(2); }
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, c=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c])); }
function safeUrl(u){
  if(!u) return '';
  if(u.startsWith('data:image/')) return u;
  try{ const x=new URL(u); return (x.protocol==='http:'||x.protocol==='https:') ? u : ''; }catch(e){ return ''; }
}
function slugify(s){ return String(s||'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,''); }

function toast(msg, type='info'){
  const t = $('toast');
  const ico = type==='ok'?'✅':type==='err'?'❌':'ℹ️';
  t.className = 'show ' + type;
  t.innerHTML = '<span>'+ico+'</span><span>'+esc(msg)+'</span>';
  clearTimeout(window.__tt);
  window.__tt = setTimeout(()=>{ t.className = type; }, 3000);
}
function openModal(id){ $(id).classList.add('show'); }
function closeModal(id){ $(id).classList.remove('show'); }
function confirmAction(text, cb){
  $('confirmText').textContent = text;
  const btn = $('confirmBtn');
  btn.onclick = ()=>{ closeModal('confirmModal'); cb(); };
  openModal('confirmModal');
}
function statusClass(s){
  const m = { pending:'badge-pending', processing:'badge-processing', completed:'badge-completed', rejected:'badge-rejected', cancelled:'badge-cancelled' };
  return m[String(s||'pending').toLowerCase()] || 'badge-pending';
}
function statusLabel(s){
  const m = { pending:'🟡 Pending', processing:'🔵 Processing', completed:'🟢 Completed', rejected:'🔴 Rejected', cancelled:'⚫ Cancelled' };
  return m[String(s||'pending').toLowerCase()] || '🟡 Pending';
}

/* =========================================================
   IMAGE UPLOAD + AUTO COMPRESS
========================================================= */
function handleImageUpload(event, key){
  const file = event.target.files && event.target.files[0];
  if(!file) return;
  if(!file.type.startsWith('image/')){ toast('শুধু Image','err'); return; }
  if(file.size > 15 * 1024 * 1024){ toast('Max 15 MB','err'); return; }

  toast('ছবি Compress হচ্ছে...','info');
  const reader = new FileReader();
  reader.onload = function(e){
    const img = new Image();
    img.onload = function(){
      try{
        const MAX_DIM = 1600;
        let w = img.width, h = img.height;
        if(w > MAX_DIM || h > MAX_DIM){
          if(w > h){ h = Math.round((h / w) * MAX_DIM); w = MAX_DIM; }
          else{ w = Math.round((w / h) * MAX_DIM); h = MAX_DIM; }
        }
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        let q = 0.85;
        let dataUrl = canvas.toDataURL('image/jpeg', q);
        while(dataUrl.length > 1.5*1024*1024 && q > 0.25){
          q -= 0.1;
          dataUrl = canvas.toDataURL('image/jpeg', q);
        }
        IMG_STORE[key] = dataUrl;
        const preview = $(key + '_preview');
        const previewImg = $(key + '_preview_img');
        const wrap = $(key + '_wrap');
        if(preview && previewImg){ previewImg.src = dataUrl; preview.classList.add('show'); }
        if(wrap) wrap.classList.add('has-image');
        const finalKB = Math.round(dataUrl.length / 1024);
        toast('ছবি Upload হয়েছে ✅ (~' + finalKB + ' KB)', 'ok');
      }catch(err){ toast('Process হয়নি','err'); }
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}
function removeImagePreview(key){
  IMG_STORE[key] = '';
  const preview = $(key + '_preview');
  const wrap = $(key + '_wrap');
  const input = $(key + '_file');
  if(preview) preview.classList.remove('show');
  if(wrap) wrap.classList.remove('has-image');
  if(input) input.value = '';
  toast('ছবি সরানো হয়েছে','info');
}
function setImagePreview(key, src){
  if(!src){
    IMG_STORE[key] = '';
    const preview = $(key + '_preview');
    const wrap = $(key + '_wrap');
    if(preview) preview.classList.remove('show');
    if(wrap) wrap.classList.remove('has-image');
    return;
  }
  IMG_STORE[key] = src;
  const preview = $(key + '_preview');
  const img = $(key + '_preview_img');
  const wrap = $(key + '_wrap');
  if(preview && img){ img.src = src; preview.classList.add('show'); }
  if(wrap) wrap.classList.add('has-image');
}

/* =========================================================
   LOGIN
========================================================= */
function doLogin(){
  const v = $('loginPass').value.trim();
  if(v === ADMIN_PASSWORD){
    try{ sessionStorage.setItem('gbs_admin_ok', '1'); }catch(e){}
    $('loginScreen').style.display = 'none';
    $('adminApp').classList.add('active');
    bootAdmin();
  } else {
    $('loginError').style.display = 'block';
    $('loginPass').value = '';
  }
}
function doLogout(){
  try{ sessionStorage.removeItem('gbs_admin_ok'); }catch(e){}
  location.reload();
}
$('loginPass').addEventListener('keypress', e=>{ if(e.key === 'Enter') doLogin(); });

/* =========================================================
   TABS
========================================================= */
document.querySelectorAll('.tab-btn').forEach(b=>{
  b.addEventListener('click', ()=>{
    const tab = b.getAttribute('data-tab');
    document.querySelectorAll('.tab-btn').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    const c = $('tab-' + tab);
    if(c) c.classList.add('active');
    window.scrollTo({ top:0, behavior:'smooth' });
    if(tab === 'dashboard') loadDashboard();
    if(tab === 'orders') loadOrders();
    if(tab === 'categories') loadCategories();
    if(tab === 'shop') loadShopItems();
    if(tab === 'meta') loadMetaProducts();
    if(tab === 'addmoney') loadAddMoney();
    if(tab === 'withdraw') loadWithdraws();
    if(tab === 'apps') loadApps();
    if(tab === 'payments') loadPayments();
    if(tab === 'tutorials') loadTutorials();
    if(tab === 'reviews') loadReviews();
    if(tab === 'users') loadUsers();
    if(tab === 'transactions') loadAllTransactions();
    if(tab === 'settings') loadSettingsForm();
  });
});

/* =========================================================
   DASHBOARD
========================================================= */
async function loadDashboard(){
  try{
    const [uSnap, oSnap, rSnap, sSnap, cSnap, mSnap] = await Promise.all([
      db.ref('users').once('value'),
      db.ref('orders').once('value'),
      db.ref('transactions').once('value'),
      db.ref('shopItems').once('value'),
      db.ref('categories').once('value'),
      db.ref('metaProducts').once('value')
    ]);
    const users = uSnap.val() || {};
    const orders = oSnap.val() || {};
    const trx = rSnap.val() || {};
    const shop = sSnap.val() || {};
    const cats = cSnap.val() || {};
    const meta = mSnap.val() || {};

    const oList = Object.keys(orders).map(k=>orders[k]);
    const tList = Object.keys(trx).map(k=>trx[k]);
    const sList = Object.keys(shop).map(k=>shop[k]);

    const pending = oList.filter(o=>o.status==='pending').length;
    const completed = oList.filter(o=>o.status==='completed').length;
    const totalCoins = oList.filter(o=>o.status==='completed').reduce((s,o)=>s+num(o.coinAmount),0);
    const totalPaid = oList.filter(o=>o.status==='completed').reduce((s,o)=>s+num(o.receiveAmount),0);
    const totalAddMoney = tList.filter(t=>t.type==='add' && t.status==='completed').reduce((s,t)=>s+num(t.amount),0);
    const totalWithdraw = tList.filter(t=>t.type==='withdraw' && t.status==='completed').reduce((s,t)=>s+num(t.amount),0);
    const totalShop = tList.filter(t=>t.type==='shop').reduce((s,t)=>s+num(t.amount),0);
    const totalMeta = tList.filter(t=>t.type==='meta').reduce((s,t)=>s+num(t.amount),0);
    const shopAvailable = sList.filter(x=>!x.sold && x.status!==false).length;

    const boxes = [
      { icon:'👥', val: Object.keys(users).length, lbl:'Users' },
      { icon:'📦', val: oList.length, lbl:'Orders' },
      { icon:'⏳', val: pending, lbl:'Pending' },
      { icon:'✅', val: completed, lbl:'Completed', color:'green' },
      { icon:'🪙', val: fmt(totalCoins), lbl:'Coins', color:'purple' },
      { icon:'💵', val: '৳'+fmtD(totalPaid), lbl:'Paid', color:'green' },
      { icon:'➕', val: '৳'+fmtD(totalAddMoney), lbl:'Add Money', color:'green' },
      { icon:'💸', val: '৳'+fmtD(totalWithdraw), lbl:'Withdraw', color:'red' },
      { icon:'🛒', val: '৳'+fmtD(totalShop), lbl:'Shop Sales', color:'purple' },
      { icon:'🎭', val: '৳'+fmtD(totalMeta), lbl:'Meta Sales', color:'purple' },
      { icon:'📊', val: shopAvailable, lbl:'Products', color:'orange' },
      { icon:'🗂️', val: Object.keys(cats).length, lbl:'Categories', color:'orange' },
      { icon:'⏳', val: tList.filter(t=>t.status === 'pending').length, lbl:'Pending Trx' }
    ];
    $('statsGrid').innerHTML = boxes.map(b=>`
      <div class="stat-box" ${b.color?`data-color="${b.color}"`:''}>
        <div class="stat-icon">${b.icon}</div>
        <div class="stat-val">${b.val}</div>
        <div class="stat-lbl">${b.lbl}</div>
      </div>
    `).join('');

    const recent = oList.sort((a,b)=>(b.createdAt||0)-(a.createdAt||0)).slice(0,5);
    const recentBox = $('recentOrders');
    if(!recent.length){
      recentBox.innerHTML = '<div class="empty"><div class="eico">📦</div><div class="etxt">Order নেই।</div></div>';
    } else {
      recentBox.innerHTML = recent.map(o=>orderItemHTML(o)).join('');
      recentBox.querySelectorAll('[data-oid]').forEach(el=>{
        el.onclick = ()=>{ closeModal('orderModal'); showOrderDetail(el.getAttribute('data-oid')); };
      });
    }
  }catch(e){ console.error(e); }
}

/* =========================================================
   ORDERS
========================================================= */
async function loadOrders(){
  const box = $('ordersList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('orders').once('value');
    const data = snap.val() || {};
    ORDERS = Object.keys(data).map(k=>({ id:k, ...data[k] }))
      .sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
    renderOrders();
  }catch(e){}
}
function renderOrders(){
  const search = ($('orderSearch').value || '').toLowerCase().trim();
  const box = $('ordersList');
  let list = ORDERS.slice();
  if(ORDER_FILTER !== 'all') list = list.filter(o=>String(o.status||'').toLowerCase() === ORDER_FILTER);
  if(search) list = list.filter(o=>{
    return (o.orderId||'').toLowerCase().includes(search)
      || (o.telegramId||'').toLowerCase().includes(search)
      || (o.username||'').toLowerCase().includes(search)
      || (o.appName||'').toLowerCase().includes(search);
  });
  if(!list.length){ box.innerHTML = '<div class="empty"><div class="eico">📦</div><div class="etxt">Order নেই।</div></div>'; return; }
  box.innerHTML = list.map(o=>orderItemHTML(o)).join('');
  box.querySelectorAll('[data-oid]').forEach(el=>{
    el.onclick = ()=> showOrderDetail(el.getAttribute('data-oid'));
  });
}
function orderItemHTML(o){
  const date = o.createdAt ? new Date(o.createdAt) : null;
  const dt = date ? date.toLocaleDateString('en-GB') + ' ' + date.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'}) : '';
  const credited = o.balanceCredited === true;
  return `<div class="order-item" data-oid="${esc(o.id)}">
    <div class="order-item-top">
      <div>
        <div class="order-item-id">#${esc(o.orderId||o.id)}</div>
        <div class="order-item-sub">${esc(o.firstName||'')} @${esc(o.username||'-')} • ${esc(dt)}</div>
      </div>
      <span class="badge ${statusClass(o.status)}">${statusLabel(o.status)}</span>
    </div>
    <div class="order-item-grid">
      <div><div class="oi-label">App</div><div class="oi-value">${esc(o.appName||'-')}</div></div>
      <div><div class="oi-label">Coins</div><div class="oi-value">${fmt(o.coinAmount)}</div></div>
      <div><div class="oi-label">Payout</div><div class="oi-value" style="color:#22c55e;">৳${fmtD(o.receiveAmount)}</div></div>
    </div>
    ${credited ? '<div style="margin-top:10px;padding-top:8px;border-top:1px dashed var(--border);font-size:11px;color:#15803d;font-weight:800;">✅ Balance-এ ৳'+fmtD(o.creditedAmount||0)+' যোগ হয়েছে</div>' : ''}
  </div>`;
}
$('orderSearch').addEventListener('input', renderOrders);
document.querySelectorAll('#orderFilters .filter-chip').forEach(c=>{
  c.addEventListener('click', ()=>{
    document.querySelectorAll('#orderFilters .filter-chip').forEach(x=>x.classList.remove('active'));
    c.classList.add('active');
    ORDER_FILTER = c.getAttribute('data-status');
    renderOrders();
  });
});
function showOrderDetail(id){
  const o = ORDERS.find(x=>x.id===id);
  if(!o) return;
  const date = o.createdAt ? new Date(o.createdAt).toLocaleString('en-GB') : '';
  const proof = o.proofUrl ? `<img class="detail-image" src="${esc(o.proofUrl)}" />` : '<div style="color:var(--muted);font-size:12px;padding:10px;">No proof</div>';
  const rangeHTML = o.rangeLabel
    ? `<div class="detail-row"><span class="dr-label">📊 Range</span><span class="dr-value">${esc(o.rangeLabel)}</span></div>`
    : '';

  const creditHTML = (o.balanceCredited === true)
    ? `<div class="credit-alert">
        <div class="ca-ico">✓</div>
        <div class="ca-content">
          <div class="ca-title">Balance Credited</div>
          <div class="ca-sub">৳${fmtD(o.creditedAmount||o.receiveAmount)} ইউজারের Main Balance-এ যোগ হয়েছে<br>Balance After: ৳${fmtD(o.balanceAfter||0)}</div>
        </div>
      </div>`
    : '';

  $('orderDetailContent').innerHTML = `
    <div class="detail-row"><span class="dr-label">Order ID</span><span class="dr-value">#${esc(o.orderId||o.id)}</span></div>
    <div class="detail-row"><span class="dr-label">Status</span><span class="dr-value"><span class="badge ${statusClass(o.status)}">${statusLabel(o.status)}</span></span></div>
    <div class="detail-row"><span class="dr-label">Name</span><span class="dr-value">${esc((o.firstName||'')+' '+(o.lastName||''))}</span></div>
    <div class="detail-row"><span class="dr-label">Username</span><span class="dr-value">@${esc(o.username||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Telegram ID</span><span class="dr-value">${esc(o.telegramId||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">App</span><span class="dr-value">${esc(o.appName||'-')}</span></div>
    ${rangeHTML}
    <div class="detail-row"><span class="dr-label">Coins</span><span class="dr-value">${fmt(o.coinAmount)}</span></div>
    <div class="detail-row"><span class="dr-label">Rate</span><span class="dr-value">৳${fmtD(o.rate)} / ${fmt(o.ratePer||1000)}</span></div>
    <div class="detail-row"><span class="dr-label">Gross</span><span class="dr-value">৳${fmtD(o.grossAmount||0)}</span></div>
    <div class="detail-row"><span class="dr-label">Fee</span><span class="dr-value">-৳${fmtD(o.sendFee||0)}</span></div>
    <div class="detail-row"><span class="dr-label">Receive</span><span class="dr-value" style="color:#22c55e;">৳${fmtD(o.receiveAmount)}</span></div>
    <div class="detail-row"><span class="dr-label">Sender Acc</span><span class="dr-value">${esc(o.senderAccount||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Date</span><span class="dr-value">${esc(date)}</span></div>
    ${creditHTML}
    <div style="font-size:12px;font-weight:700;margin-top:12px;margin-bottom:6px;">📷 Proof</div>
    ${proof}`;

  const s = String(o.status||'pending').toLowerCase();
  let btns = '';
  if(s !== 'processing') btns += `<button class="btn btn-primary" onclick="updateOrderStatus('${o.id}','processing')">🔵 Processing</button>`;
  if(s !== 'completed') btns += `<button class="btn btn-success" onclick="updateOrderStatus('${o.id}','completed')">✅ Complete + Balance Add</button>`;
  if(s !== 'rejected') btns += `<button class="btn btn-danger" onclick="updateOrderStatus('${o.id}','rejected')">🔴 Reject</button>`;
  btns += `<button class="btn btn-ghost" onclick="deleteOrder('${o.id}')">🗑 Delete</button>`;
  $('orderActions').innerHTML = btns;
  openModal('orderModal');
}

/* =========================================================
   UPDATE ORDER STATUS + AUTO BALANCE CREDIT
========================================================= */
async function updateOrderStatus(id, status){
  try{
    const orderSnap = await db.ref('orders/' + id).once('value');
    const order = orderSnap.val();
    if(!order){ toast('Order পাওয়া যায়নি','err'); return; }

    const newStatus = String(status || '').toLowerCase();
    const alreadyCredited = order.balanceCredited === true;

    /* Update status */
    await db.ref('orders/' + id).update({
      status: newStatus,
      updatedAt: Date.now()
    });

    /* Auto-credit balance when status becomes completed */
    if(newStatus === 'completed' && !alreadyCredited){
      const telegramId = String(order.telegramId || '');
      const receiveAmt = num(order.receiveAmount || 0);

      if(telegramId && receiveAmt > 0){
        /* Get current balance */
        const balSnap = await db.ref('users/' + telegramId + '/balance').once('value');
        const currentBalance = num(balSnap.val()) || 0;
        const newBalance = currentBalance + receiveAmt;

        /* Update user balance */
        await db.ref('users/' + telegramId + '/balance').set(newBalance);

        /* Mark order as credited */
        await db.ref('orders/' + id).update({
          balanceCredited: true,
          creditedAt: Date.now(),
          creditedAmount: receiveAmt,
          balanceAfter: newBalance
        });

        /* Create transaction record */
        const trxId = 'SELL-' + Date.now().toString().slice(-8);
        await db.ref('transactions/' + trxId).set({
          trxId,
          telegramId,
          username: order.username || '',
          firstName: order.firstName || '',
          photoUrl: order.photoUrl || '',
          type: 'add',
          label: 'Coin Sell • ' + (order.appName || 'App'),
          amount: receiveAmt,
          orderId: order.orderId || id,
          coinAmount: num(order.coinAmount || 0),
          rangeLabel: order.rangeLabel || '',
          status: 'completed',
          createdAt: Date.now()
        });

        toast('✅ Complete! ৳'+fmtD(receiveAmt)+' Balance যোগ হয়েছে (নতুন: ৳'+fmtD(newBalance)+')', 'ok');
      } else {
        toast('Order Completed (User/Amount নেই)','info');
      }
    } else if(newStatus === 'completed' && alreadyCredited){
      toast('Order Completed (আগেই Credit হয়েছে)','info');
    } else if(newStatus === 'rejected' && alreadyCredited){
      /* If rejected after credited, refund (subtract) from user balance */
      const telegramId = String(order.telegramId || '');
      const amt = num(order.creditedAmount || order.receiveAmount || 0);
      if(telegramId && amt > 0){
        const balSnap = await db.ref('users/' + telegramId + '/balance').once('value');
        const curr = num(balSnap.val()) || 0;
        const newBal = Math.max(0, curr - amt);
        await db.ref('users/' + telegramId + '/balance').set(newBal);
        await db.ref('orders/' + id).update({
          balanceCredited: false,
          refundedAt: Date.now(),
          refundedAmount: amt
        });
        toast('⚠️ Order Rejected + ৳'+fmtD(amt)+' Balance থেকে কেটে নেওয়া হয়েছে', 'err');
      } else {
        toast('Order Rejected','ok');
      }
    } else {
      toast('Status Update হয়েছে','ok');
    }

    closeModal('orderModal');
    loadOrders();
    loadDashboard();
  }catch(e){
    console.error(e);
    toast('Update হয়নি','err');
  }
}

function deleteOrder(id){
  confirmAction('Order মুছে ফেলতে চান? Balance থাকলে তা কাটবে না।', async ()=>{
    try{ await db.ref('orders/' + id).remove(); closeModal('orderModal'); loadOrders(); toast('Delete','ok'); }
    catch(e){ toast('হয়নি','err'); }
  });
}

/* =========================================================
   CATEGORIES
========================================================= */
async function loadCategories(){
  const box = $('categoryList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('categories').once('value');
    const data = snap.val() || {};
    const prodSnap = await db.ref('shopItems').once('value');
    const prods = prodSnap.val() || {};
    CATEGORIES = Object.keys(data).map(k=>({ id:k, ...data[k] }));
    renderCategories(prods);
  }catch(e){ box.innerHTML = '<div class="empty"><div class="eico">❌</div><div class="etxt">লোড হয়নি।</div></div>'; }
}
function renderCategories(prods){
  const box = $('categoryList');
  if(!CATEGORIES.length){
    box.innerHTML = '<div class="empty" style="grid-column:1/-1;"><div class="eico">🗂️</div><div class="etxt">কোনো Category নেই। Add করুন।</div></div>';
    return;
  }
  box.innerHTML = CATEGORIES.map(c=>{
    let count = 0;
    Object.keys(prods || {}).forEach(k=>{
      if(prods[k].category === c.id) count++;
    });
    const typeIcon = c.type === 'proxy' ? '🌐' : c.type === 'vpn' ? '🔒' : c.type === 'meta' ? '🎭' : '📦';
    return `
      <div class="category-card" onclick="openCategoryForEdit('${c.id}')">
        <button class="cc-del" onclick="event.stopPropagation(); deleteCategory('${c.id}')" type="button">✕</button>
        <div class="cc-ico">${esc(c.icon || '📦')}</div>
        <div class="cc-name">${esc(c.name)}</div>
        <div class="cc-count">${count} • ${typeIcon} ${esc(c.type||'package')}</div>
      </div>
    `;
  }).join('');
}
function openCategoryForEdit(cid){
  const c = CATEGORIES.find(x=>x.id===cid);
  if(!c) return;
  $('categoryModalTitle').textContent = '✏️ Edit Category';
  $('cat_id').value = c.id;
  $('cat_name').value = c.name || '';
  $('cat_icon').value = c.icon || '';
  $('cat_type').value = c.type || 'package';
  openModal('categoryModal');
}
function openCategoryModal(){
  $('categoryModalTitle').textContent = '➕ Add Category';
  $('cat_id').value = '';
  $('cat_name').value = '';
  $('cat_icon').value = '';
  $('cat_type').value = 'package';
  openModal('categoryModal');
}
function autoDetectIcon(){
  const name = ($('cat_name').value || '').toLowerCase().trim();
  if(!name) return;
  if($('cat_icon').value) return;
  for(const key of Object.keys(ICON_MAP)){
    if(name.includes(key)){
      $('cat_icon').value = ICON_MAP[key];
      if(key === 'proxy') $('cat_type').value = 'proxy';
      else if(key === 'vpn') $('cat_type').value = 'vpn';
      else if(key === 'meta' || key === 'facebook' || key === 'fb') $('cat_type').value = 'meta';
      break;
    }
  }
}
async function saveCategory(){
  const existingId = ($('cat_id').value || '').trim();
  const name = $('cat_name').value.trim();
  const icon = $('cat_icon').value.trim() || '📦';
  const type = $('cat_type').value || 'package';
  if(!name){ toast('Category Name দিন','err'); return; }
  const id = existingId || slugify(name) || ('cat_' + Date.now());
  const payload = { name, icon, type, updatedAt: Date.now() };
  if(!existingId) payload.createdAt = Date.now();
  try{
    if(existingId) await db.ref('categories/' + existingId).update(payload);
    else await db.ref('categories/' + id).set(payload);
    toast('Category Save ✅','ok');
    closeModal('categoryModal');
    loadCategories();
  }catch(e){ toast('Save হয়নি','err'); }
}
function deleteCategory(cid){
  const c = CATEGORIES.find(x=>x.id===cid);
  confirmAction('"'+ (c?.name||'') +'" মুছে ফেলবেন? এর সব Product-ও Delete হবে।', async ()=>{
    try{
      const prodSnap = await db.ref('shopItems').once('value');
      const prods = prodSnap.val() || {};
      const updates = {};
      Object.keys(prods).forEach(k=>{ if(prods[k].category === cid) updates['shopItems/' + k] = null; });
      updates['categories/' + cid] = null;
      await db.ref().update(updates);
      toast('Category Delete ✅','ok');
      loadCategories();
    }catch(e){ toast('হয়নি','err'); }
  });
}

/* =========================================================
   SHOP PRODUCTS
========================================================= */
async function loadShopItems(){
  const box = $('shopList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('shopItems').once('value');
    const data = snap.val() || {};
    SHOP_ITEMS = Object.keys(data).map(k=>({ id:k, ...data[k] }))
      .sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
    await populateShopFilters();
    renderShopList();
  }catch(e){}
}
async function populateShopFilters(){
  const wrap = $('shopFilters');
  try{
    const snap = await db.ref('categories').once('value');
    const cats = snap.val() || {};
    CATEGORIES = Object.keys(cats).map(k=>({ id:k, ...cats[k] }));
  }catch(e){}
  wrap.innerHTML = '<button class="filter-chip active" data-cat="all">All</button>'
    + CATEGORIES.map(c=>`<button class="filter-chip" data-cat="${esc(c.id)}">${esc(c.icon||'')} ${esc(c.name)}</button>`).join('')
    + '<button class="filter-chip" data-cat="__sold">✅ Sold</button>';
  wrap.querySelectorAll('.filter-chip').forEach(b=>{
    b.addEventListener('click', ()=>{
      wrap.querySelectorAll('.filter-chip').forEach(x=>x.classList.remove('active'));
      b.classList.add('active');
      SHOP_CAT_FILTER = b.getAttribute('data-cat');
      renderShopList();
    });
  });
}
function renderShopList(){
  const box = $('shopList');
  let list = SHOP_ITEMS.slice();
  if(SHOP_CAT_FILTER === '__sold') list = list.filter(x=>x.sold === true);
  else if(SHOP_CAT_FILTER !== 'all') list = list.filter(x=>x.category === SHOP_CAT_FILTER && !x.sold);

  if(!list.length){ box.innerHTML = '<div class="empty"><div class="eico">🛒</div><div class="etxt">Product নেই।</div></div>'; return; }
  box.innerHTML = list.map(item=>{
    const logo = safeUrl(item.logo) || 'https://ui-avatars.com/api/?name='+encodeURIComponent(item.name||'I')+'&background=8b5cf6&color=fff';
    const isSold = item.sold === true;
    const active = item.status !== false && !isSold;
    const cat = CATEGORIES.find(c=>c.id === item.category) || { name: item.category||'—', icon: '📦', type: 'package' };
    const catLabel = (cat.icon||'📦') + ' ' + (cat.name||'-');
    const pkgs = Array.isArray(item.packages) ? item.packages : [];
    const pkgText = pkgs.length ? pkgs.map(p=>`${p.name} = ৳${fmtD(p.price)}`).join(' • ') : 'No packages';

    let detailLine = '';
    if(cat.type === 'proxy' && item.proxyDetails){
      detailLine = `🌐 ${esc(item.proxyDetails.host||'-')} : ${esc(item.proxyDetails.port||'-')} • 👤 ${esc(item.proxyDetails.username||'-')}`;
    } else if(cat.type === 'vpn'){
      detailLine = `📧 ${esc(item.vpnEmail||'-')}`;
    } else if(cat.type === 'meta'){
      detailLine = `🎭 Google Sheet: ${esc((item.sheetUrl||'').slice(0,40))}...`;
    } else {
      detailLine = `📦 ${pkgs.length} packages`;
    }

    return `
      <div class="card">
        <div class="card-head">
          <div class="card-title">
            <img src="${esc(logo)}" />
            <div class="card-title-text">
              <div class="ct-name">${esc(item.name||'-')} <span class="badge badge-cat">${catLabel}</span></div>
              <div class="ct-sub">${esc(item.proxyBy||'-')}</div>
            </div>
          </div>
          ${isSold ? '<span class="badge badge-sold">SOLD</span>' : (active ? '<span class="badge badge-active">Active</span>' : '<span class="badge badge-stop">Hidden</span>')}
        </div>
        <div style="font-size:11.5px;color:var(--muted);margin-bottom:8px;">${detailLine}</div>
        <div style="font-size:11px;color:#7c3aed;font-weight:700;margin-bottom:10px;">📦 ${esc(pkgText)}</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          ${!isSold ? `<button class="btn ${active?'btn-warning':'btn-success'} btn-icon" onclick="toggleShopItem('${item.id}', ${active})">${active?'🔴 Hide':'🟢 Show'}</button>` : ''}
          ${!isSold ? `<button class="btn btn-primary btn-icon" onclick="editShopItem('${item.id}')">✏️ Edit</button>` : ''}
          <button class="btn btn-danger btn-icon" onclick="deleteShopItem('${item.id}')">🗑 Delete</button>
        </div>
      </div>
    `;
  }).join('');
}

async function populateShopCategoryDropdown(){
  const sel = $('shop_category');
  if(!sel) return;
  try{
    const snap = await db.ref('categories').once('value');
    const cats = snap.val() || {};
    CATEGORIES = Object.keys(cats).map(k=>({ id:k, ...cats[k] }));
    sel.innerHTML = '<option value="">-- Select --</option>'
      + CATEGORIES.filter(c=>c.type !== 'meta').map(c=>`<option value="${esc(c.id)}">${esc(c.icon||'')} ${esc(c.name)} (${esc(c.type||'package')})</option>`).join('');
  }catch(e){}
}

function updateProductFields(){
  const cid = $('shop_category').value;
  const sec = $('dynamicFieldsSection');
  const cont = $('dynamicFieldsContainer');
  const title = $('dynamicFieldsTitle');

  if(!cid){ sec.style.display = 'none'; return; }
  const cat = CATEGORIES.find(c=>c.id === cid);
  if(!cat){ sec.style.display = 'none'; return; }

  if(cat.type === 'proxy'){
    sec.style.display = 'block';
    title.innerHTML = '🌐 Proxy Details';
    cont.innerHTML = `
      <div class="form-row"><label>Host / Server *</label><input type="text" id="dyn_host" class="form-input" placeholder="proxy.example.com" /></div>
      <div class="form-grid-2">
        <div class="form-row"><label>Port *</label><input type="text" id="dyn_port" class="form-input" placeholder="8080" /></div>
        <div class="form-row"><label>Username *</label><input type="text" id="dyn_username" class="form-input" placeholder="user123" /></div>
      </div>
      <div class="form-row"><label>Password *</label><input type="text" id="dyn_password" class="form-input" placeholder="pass123" /></div>
      <div class="cfs-hint">⚠️ User এই Data Proxy কেনার পর পাবে। একবার কেউ কিনলে Auto Sold হয়ে যাবে।</div>
    `;
  } else if(cat.type === 'vpn'){
    sec.style.display = 'block';
    title.innerHTML = '🔒 VPN Details';
    cont.innerHTML = `
      <div class="form-row"><label>VPN Email *</label><input type="text" id="dyn_vpnEmail" class="form-input" placeholder="user@example.com" /></div>
      <div class="form-row"><label>VPN Password *</label><input type="text" id="dyn_vpnPassword" class="form-input" placeholder="pass123" /></div>
      <div class="cfs-hint">⚠️ User এই Email ও Password পাবে VPN কেনার পর।</div>
    `;
  } else {
    sec.style.display = 'none';
    cont.innerHTML = '';
  }
}
function readDynamicFields(){
  const cid = $('shop_category').value;
  const cat = CATEGORIES.find(c=>c.id === cid);
  if(!cat) return {};
  if(cat.type === 'proxy'){
    return {
      proxyDetails: {
        host: ($('dyn_host')?.value || '').trim(),
        port: ($('dyn_port')?.value || '').trim(),
        username: ($('dyn_username')?.value || '').trim(),
        password: ($('dyn_password')?.value || '').trim()
      }
    };
  } else if(cat.type === 'vpn'){
    return {
      vpnEmail: ($('dyn_vpnEmail')?.value || '').trim(),
      vpnPassword: ($('dyn_vpnPassword')?.value || '').trim()
    };
  }
  return {};
}

/* PACKAGE BUILDER */
function addPkgRow(name, price){
  PKG_ROWS.push({ name: name || '', price: price || '' });
  renderPkgBuilder();
}
function removePkgRow(idx){
  PKG_ROWS.splice(idx, 1);
  if(!PKG_ROWS.length) PKG_ROWS.push({ name:'', price:'' });
  renderPkgBuilder();
}
function renderPkgBuilder(){
  const box = $('pkgBuilder');
  if(!PKG_ROWS.length) PKG_ROWS.push({ name:'', price:'' });
  box.innerHTML = PKG_ROWS.map((p, i)=>`
    <div class="pkg-builder-row">
      <input type="text" class="form-input" placeholder="Name (1 GB)" value="${esc(p.name)}" oninput="PKG_ROWS[${i}].name=this.value" />
      <input type="number" class="form-input" placeholder="Price ৳" value="${esc(p.price)}" oninput="PKG_ROWS[${i}].price=this.value" />
      <button class="btn btn-danger btn-icon" onclick="removePkgRow(${i})" type="button" style="padding:9px 12px;">✕</button>
    </div>
  `).join('');
}

async function openShopModal(){
  await populateShopCategoryDropdown();
  $('shopModalTitle').textContent = '➕ Add Product';
  $('shop_id').value = '';
  $('shop_category').value = '';
  $('shop_name').value = '';
  $('shop_proxyBy').value = '';
  $('shop_status').checked = true;
  $('dynamicFieldsSection').style.display = 'none';
  $('dynamicFieldsContainer').innerHTML = '';
  IMG_STORE.shop_logo = '';
  if($('shop_logo_preview')) $('shop_logo_preview').classList.remove('show');
  if($('shop_logo_wrap')) $('shop_logo_wrap').classList.remove('has-image');
  PKG_ROWS = [{ name:'', price:'' }];
  renderPkgBuilder();
  openModal('shopModal');
}

async function editShopItem(id){
  await populateShopCategoryDropdown();
  const item = SHOP_ITEMS.find(x=>x.id===id);
  if(!item){ toast('পাওয়া যায়নি','err'); return; }
  $('shopModalTitle').textContent = '✏️ Edit Product';
  $('shop_id').value = item.id;
  $('shop_category').value = item.category || '';
  $('shop_name').value = item.name || '';
  $('shop_proxyBy').value = item.proxyBy || '';
  $('shop_status').checked = item.status !== false;
  setImagePreview('shop_logo', item.logo || '');
  updateProductFields();
  const cat = CATEGORIES.find(c=>c.id === item.category);
  if(cat){
    if(cat.type === 'proxy' && item.proxyDetails){
      if($('dyn_host')) $('dyn_host').value = item.proxyDetails.host || '';
      if($('dyn_port')) $('dyn_port').value = item.proxyDetails.port || '';
      if($('dyn_username')) $('dyn_username').value = item.proxyDetails.username || '';
      if($('dyn_password')) $('dyn_password').value = item.proxyDetails.password || '';
    } else if(cat.type === 'vpn'){
      if($('dyn_vpnEmail')) $('dyn_vpnEmail').value = item.vpnEmail || '';
      if($('dyn_vpnPassword')) $('dyn_vpnPassword').value = item.vpnPassword || '';
    }
  }
  PKG_ROWS = (Array.isArray(item.packages) && item.packages.length)
    ? item.packages.map(p=>({ name:p.name, price:p.price }))
    : [{ name:'', price:'' }];
  renderPkgBuilder();
  openModal('shopModal');
}

async function saveShopItem(){
  const existingId = ($('shop_id').value || '').trim();
  const id = existingId || ('prod_' + Date.now());
  const name = $('shop_name').value.trim();
  const category = $('shop_category').value.trim();
  if(!name){ toast('Product Name দিন','err'); return; }
  if(!category){ toast('Category সিলেক্ট করুন','err'); return; }

  const packages = PKG_ROWS
    .filter(p=>p.name && p.price)
    .map(p=>({ name: p.name, price: num(p.price) }));
  if(!packages.length){ toast('কমপক্ষে একটা Package দিন','err'); return; }

  const payload = {
    category,
    name,
    logo: IMG_STORE.shop_logo || '',
    proxyBy: $('shop_proxyBy').value.trim(),
    packages,
    status: $('shop_status').checked,
    updatedAt: Date.now()
  };

  const dyn = readDynamicFields();
  Object.assign(payload, dyn);

  if(!existingId){
    payload.createdAt = Date.now();
    payload.sold = false;
  }

  try{
    if(existingId) await db.ref('shopItems/' + id).update(payload);
    else await db.ref('shopItems/' + id).set(payload);
    toast('Save হয়েছে ✅','ok');
    closeModal('shopModal');
    loadShopItems();
  }catch(e){ console.error(e); toast('Save হয়নি','err'); }
}

async function toggleShopItem(id, isActive){
  try{ await db.ref('shopItems/' + id).update({ status: !isActive }); loadShopItems(); }
  catch(e){ toast('হয়নি','err'); }
}
function deleteShopItem(id){
  confirmAction('Product মুছে ফেলতে চান?', async ()=>{
    try{ await db.ref('shopItems/' + id).remove(); toast('Delete','ok'); loadShopItems(); }
    catch(e){ toast('হয়নি','err'); }
  });
}

/* =========================================================
   META ACCOUNT SELL
========================================================= */
async function loadMetaProducts(){
  const box = $('metaProductsList');
  if(!box) return;
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('metaProducts').once('value');
    const data = snap.val() || {};
    META_PRODUCTS = Object.keys(data).map(k=>({ id:k, ...data[k] }))
      .sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));

    let totalAccounts = 0, totalSold = 0, totalRevenue = 0;
    for(const p of META_PRODUCTS){
      const accounts = await getMetaAccounts(p);
      totalAccounts += accounts.length;
      totalSold += accounts.filter(a=>a.status==='sold').length;
      totalRevenue += accounts.filter(a=>a.status==='sold').length * num(p.price);
    }
    $('metaStatsGrid').innerHTML = `
      <div class="stat-box" data-color="purple"><div class="stat-icon">🎭</div><div class="stat-val">${META_PRODUCTS.length}</div><div class="stat-lbl">Products</div></div>
      <div class="stat-box" data-color="green"><div class="stat-icon">📦</div><div class="stat-val">${totalAccounts}</div><div class="stat-lbl">Total Accounts</div></div>
      <div class="stat-box" data-color="red"><div class="stat-icon">🔴</div><div class="stat-val">${totalSold}</div><div class="stat-lbl">Sold</div></div>
      <div class="stat-box"><div class="stat-icon">💵</div><div class="stat-val">৳${fmtD(totalRevenue)}</div><div class="stat-lbl">Revenue</div></div>
    `;

    renderMetaProducts();
    loadMetaPurchases();
  }catch(e){ console.error(e); box.innerHTML = '<div class="empty"><div class="eico">❌</div><div class="etxt">লোড হয়নি</div></div>'; }
}

async function getMetaAccounts(product){
  let accounts = [];
  if(product.manualAccounts && product.manualAccounts.trim()){
    accounts = product.manualAccounts.trim().split('\n').filter(l=>l.includes(',')).map(l=>{
      const [u, ...p] = l.split(',');
      return { username: u.trim(), password: p.join(',').trim() };
    });
  }
  if(product.sheetUrl){
    try{
      const sheetAccounts = await fetchSheetAccounts(product.sheetUrl);
      accounts = accounts.concat(sheetAccounts);
    }catch(e){ console.warn('Sheet load failed', e); }
  }
  const soldSnap = await db.ref('metaSold/' + product.id).once('value');
  const soldData = soldSnap.val() || {};
  const seen = {};
  accounts = accounts.filter(a=>{
    const k = String(a.username||'').toLowerCase();
    if(!k || seen[k]) return false;
    seen[k] = true;
    return true;
  }).map(a=>{
    const sold = soldData[a.username];
    return {
      username: a.username,
      password: a.password,
      status: sold ? 'sold' : 'available',
      soldTo: sold ? sold.telegramId : null,
      soldToName: sold ? sold.firstName : null,
      soldAt: sold ? sold.soldAt : null
    };
  });
  return accounts;
}

async function fetchSheetAccounts(url){
  if(!url) return [];
  let csvUrl = url;
  if(url.includes('docs.google.com/spreadsheets')){
    if(!url.includes('output=csv') && !url.includes('export?format=csv')){
      const m = url.match(/\/d\/([a-zA-Z0-9-_]+)/);
      if(m){
        const id = m[1];
        const gidMatch = url.match(/gid=([0-9]+)/);
        const gid = gidMatch ? gidMatch[1] : '0';
        csvUrl = `https://docs.google.com/spreadsheets/d/${id}/export?format=csv&gid=${gid}`;
      }
    }
  }
  const res = await fetch(csvUrl);
  if(!res.ok) throw new Error('Failed to fetch');
  const text = await res.text();
  const lines = text.split('\n').filter(l=>l.trim());
  if(!lines.length) return [];
  const rows = lines.map(l=>{
    const parts = l.split(',');
    return parts.map(x=>x.trim().replace(/^"|"$/g, ''));
  });
  let start = 0;
  if(rows[0] && /user|email|pass/i.test(rows[0].join(' '))) start = 1;
  return rows.slice(start).map(r=>{
    return { username: r[0] || '', password: r[1] || '' };
  }).filter(a=>a.username);
}

function renderMetaProducts(){
  const box = $('metaProductsList');
  if(!META_PRODUCTS.length){
    box.innerHTML = `<div class="empty"><div class="eico">🎭</div><div class="etxt">কোনো Meta Product নেই। Add করুন।</div></div>`;
    return;
  }
  box.innerHTML = META_PRODUCTS.map(p=>{
    const logo = safeUrl(p.logo) || 'https://ui-avatars.com/api/?name='+encodeURIComponent(p.name||'M')+'&background=8b5cf6&color=fff';
    const active = p.status !== false;
    const cat = CATEGORIES.find(c=>c.id === p.category) || { name: p.category||'—', icon: '🎭' };
    return `<div class="card">
      <div class="card-head">
        <div class="card-title">
          <img src="${esc(logo)}" />
          <div class="card-title-text">
            <div class="ct-name">${esc(p.name||'-')} <span class="badge badge-cat">${esc(cat.icon||'🎭')} ${esc(cat.name||'-')}</span></div>
            <div class="ct-sub">৳${fmtD(p.price)} per account</div>
          </div>
        </div>
        <span class="badge ${active?'badge-active':'badge-stop'}">${active?'Active':'Hidden'}</span>
      </div>
      ${p.sheetUrl ? `<div style="font-size:11px;color:#7c3aed;word-break:break-all;margin-bottom:6px;">🔗 ${esc(p.sheetUrl)}</div>` : ''}
      <div style="font-size:11.5px;color:var(--muted);margin-bottom:10px;">${esc(p.description||'')}</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button class="btn btn-purple btn-icon" onclick="viewMetaAccounts('${p.id}')">👁 Accounts</button>
        <button class="btn btn-primary btn-icon" onclick="editMetaProduct('${p.id}')">✏️ Edit</button>
        <button class="btn ${active?'btn-warning':'btn-success'} btn-icon" onclick="toggleMetaProduct('${p.id}', ${active})">${active?'🔴 Hide':'🟢 Show'}</button>
        <button class="btn btn-danger btn-icon" onclick="deleteMetaProduct('${p.id}')">🗑 Delete</button>
      </div>
    </div>`;
  }).join('');
}

async function viewMetaAccounts(pid){
  const p = META_PRODUCTS.find(x=>x.id===pid);
  if(!p) return;
  CURRENT_META_PRODUCT_ID = pid;
  CURRENT_META_ACCOUNTS = await getMetaAccounts(p);
  META_ACCOUNT_FILTER = 'all';
  $('metaAccountsTitle').textContent = '🎭 ' + (p.name||'Accounts') + ' — ' + CURRENT_META_ACCOUNTS.length + ' accounts';
  renderMetaAccountsList();
  openModal('metaAccountsModal');
}

function filterMetaAccounts(f){
  META_ACCOUNT_FILTER = f;
  document.querySelectorAll('[data-macc]').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('[data-macc="'+f+'"]').forEach(x=>x.classList.add('active'));
  renderMetaAccountsList();
}

function renderMetaAccountsList(){
  const box = $('metaAccountsList');
  let list = CURRENT_META_ACCOUNTS.slice();
  if(META_ACCOUNT_FILTER !== 'all') list = list.filter(a=>a.status === META_ACCOUNT_FILTER);
  if(!list.length){ box.innerHTML = '<div class="empty"><div class="eico">📦</div><div class="etxt">কোনো অ্যাকাউন্ট নেই।</div></div>'; return; }
  box.innerHTML = list.map(a=>`
    <div class="meta-account-row ${a.status==='sold'?'sold':''}">
      <div class="ma-user">👤 ${esc(a.username)}</div>
      <div class="ma-pass">🔑 ${esc(a.password)}</div>
      <div class="ma-status ${a.status}">${a.status==='sold'?'SOLD':'FREE'}</div>
    </div>
  `).join('');
}

function openMetaModal(){
  $('metaModalTitle').textContent = '➕ Add Meta Product';
  $('meta_id').value = '';
  $('meta_name').value = '';
  $('meta_sheetUrl').value = '';
  $('meta_price').value = SETTINGS.metaDefaultPrice || '0.50';
  $('meta_status').value = 'active';
  $('meta_description').value = '';
  $('meta_manualAccounts').value = '';
  IMG_STORE.meta_logo = '';
  if($('meta_logo_preview')) $('meta_logo_preview').classList.remove('show');
  if($('meta_logo_wrap')) $('meta_logo_wrap').classList.remove('has-image');
  populateMetaCategoryDropdown();
  openModal('metaModal');
}

async function populateMetaCategoryDropdown(){
  const sel = $('meta_category');
  if(!sel) return;
  try{
    const snap = await db.ref('categories').once('value');
    const cats = snap.val() || {};
    CATEGORIES = Object.keys(cats).map(k=>({ id:k, ...cats[k] }));
    const metaCats = CATEGORIES.filter(c=>c.type === 'meta');
    sel.innerHTML = '<option value="">-- Select Meta Category --</option>'
      + metaCats.map(c=>`<option value="${esc(c.id)}">${esc(c.icon||'🎭')} ${esc(c.name)}</option>`).join('');
  }catch(e){}
}

async function editMetaProduct(pid){
  await populateMetaCategoryDropdown();
  const p = META_PRODUCTS.find(x=>x.id===pid);
  if(!p) return;
  $('metaModalTitle').textContent = '✏️ Edit Meta Product';
  $('meta_id').value = p.id;
  $('meta_name').value = p.name || '';
  $('meta_sheetUrl').value = p.sheetUrl || '';
  $('meta_price').value = p.price || '0.50';
  $('meta_status').value = p.status === false ? 'hidden' : 'active';
  $('meta_description').value = p.description || '';
  $('meta_manualAccounts').value = p.manualAccounts || '';
  $('meta_category').value = p.category || '';
  setImagePreview('meta_logo', p.logo || '');
  openModal('metaModal');
}

async function saveMetaProduct(){
  const existingId = ($('meta_id').value || '').trim();
  const id = existingId || ('meta_' + Date.now());
  const name = $('meta_name').value.trim();
  const category = $('meta_category').value.trim();
  const sheetUrl = $('meta_sheetUrl').value.trim();
  const manualAccounts = $('meta_manualAccounts').value.trim();

  if(!name){ toast('Product Name দিন','err'); return; }
  if(!category){ toast('Meta Category সিলেক্ট করুন','err'); return; }
  if(!sheetUrl && !manualAccounts){ toast('Sheet URL বা Manual Account দিন','err'); return; }

  const payload = {
    name,
    category,
    logo: IMG_STORE.meta_logo || '',
    sheetUrl,
    manualAccounts,
    price: num($('meta_price').value) || 0.50,
    description: $('meta_description').value.trim(),
    status: $('meta_status').value === 'active',
    updatedAt: Date.now()
  };
  if(!existingId) payload.createdAt = Date.now();

  try{
    if(existingId) await db.ref('metaProducts/' + id).update(payload);
    else await db.ref('metaProducts/' + id).set(payload);
    toast('Save হয়েছে ✅','ok');
    closeModal('metaModal');
    loadMetaProducts();
  }catch(e){ toast('Save হয়নি','err'); }
}

async function toggleMetaProduct(pid, isActive){
  try{ await db.ref('metaProducts/' + pid).update({ status: !isActive }); loadMetaProducts(); }
  catch(e){ toast('হয়নি','err'); }
}

function deleteMetaProduct(pid){
  confirmAction('Meta Product মুছে ফেলবেন? Sold অ্যাকাউন্টও রিমুভ হবে।', async ()=>{
    try{
      await db.ref('metaProducts/' + pid).remove();
      await db.ref('metaSold/' + pid).remove();
      toast('Deleted','ok');
      loadMetaProducts();
    }catch(e){ toast('হয়নি','err'); }
  });
}

async function loadMetaPurchases(){
  const box = $('metaPurchasesList');
  if(!box) return;
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('metaPurchases').once('value');
    const data = snap.val() || {};
    META_PURCHASES = Object.keys(data).map(k=>({ id:k, ...data[k] }))
      .sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
    renderMetaPurchases();
  }catch(e){}
}

function renderMetaPurchases(){
  const box = $('metaPurchasesList');
  let list = META_PURCHASES.slice();
  if(META_PURCHASE_FILTER === 'today'){
    const start = new Date(); start.setHours(0,0,0,0);
    list = list.filter(x=>(x.createdAt||0) >= start.getTime());
  } else if(META_PURCHASE_FILTER === 'week'){
    const start = Date.now() - 7*24*60*60*1000;
    list = list.filter(x=>(x.createdAt||0) >= start);
  }
  if(!list.length){ box.innerHTML = '<div class="empty"><div class="eico">🧾</div><div class="etxt">কোনো Purchase নেই।</div></div>'; return; }
  box.innerHTML = list.slice(0,100).map(p=>{
    const dt = p.createdAt ? new Date(p.createdAt).toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) : '';
    return `<div class="card">
      <div class="card-head">
        <div class="card-title-text" style="flex:1;">
          <div class="ct-name">#${esc(p.trxId||p.id)} • ${esc(p.productName||'-')}</div>
          <div class="ct-sub">${esc(p.firstName||'')} @${esc(p.username||'-')} • ${esc(dt)}</div>
        </div>
        <span class="badge badge-completed">৳${fmtD(p.totalPrice)}</span>
      </div>
      <div style="font-size:11.5px;color:var(--muted);margin-bottom:6px;">🎭 ${p.accountsCount||0} accounts • Telegram: ${esc(p.telegramId||'-')}</div>
      <div style="font-size:11px;color:#7c3aed;word-break:break-all;">👤 ${(p.usernames||[]).slice(0,3).map(u=>esc(u)).join(', ')}${(p.usernames||[]).length>3?'...':''}</div>
    </div>`;
  }).join('');
}

document.querySelectorAll('#metaPurchaseFilters .filter-chip').forEach(c=>{
  c.addEventListener('click', ()=>{
    document.querySelectorAll('#metaPurchaseFilters .filter-chip').forEach(x=>x.classList.remove('active'));
    c.classList.add('active');
    META_PURCHASE_FILTER = c.getAttribute('data-mfilter');
    renderMetaPurchases();
  });
});

/* =========================================================
   ADD MONEY
========================================================= */
async function loadAddMoney(){
  const box = $('addMoneyList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('addMoneyRequests').once('value');
    const data = snap.val() || {};
    ADD_MONEY_REQS = Object.keys(data).map(k=>({ id:k, ...data[k] })).sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
    renderAddMoneyList();
  }catch(e){}
}
function renderAddMoneyList(){
  const box = $('addMoneyList');
  let list = ADD_MONEY_REQS.slice();
  if(AM_FILTER !== 'all') list = list.filter(x=>x.status === AM_FILTER);
  if(!list.length){ box.innerHTML = '<div class="empty"><div class="eico">➕</div><div class="etxt">Request নেই।</div></div>'; return; }
  box.innerHTML = list.map(r=>{
    const dt = r.createdAt ? new Date(r.createdAt).toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) : '';
    return `<div class="order-item" data-amid="${esc(r.id)}">
      <div class="order-item-top">
        <div>
          <div class="order-item-id">#${esc(r.trxId||r.id)}</div>
          <div class="order-item-sub">${esc(r.firstName||'')} @${esc(r.username||'-')} • ${esc(dt)}</div>
        </div>
        <span class="badge ${statusClass(r.status)}">${statusLabel(r.status)}</span>
      </div>
      <div class="order-item-grid">
        <div><div class="oi-label">Method</div><div class="oi-value">${esc(r.method||'-')}</div></div>
        <div><div class="oi-label">TrxID</div><div class="oi-value">${esc(r.userTrxId||'-')}</div></div>
        <div><div class="oi-label">Amount</div><div class="oi-value" style="color:#22c55e;">৳${fmtD(r.amount)}</div></div>
      </div>
    </div>`;
  }).join('');
  box.querySelectorAll('[data-amid]').forEach(el=>{
    el.onclick = ()=> showAddMoneyDetail(el.getAttribute('data-amid'));
  });
}
document.querySelectorAll('#amFilters .filter-chip').forEach(c=>{
  c.addEventListener('click', ()=>{
    document.querySelectorAll('#amFilters .filter-chip').forEach(x=>x.classList.remove('active'));
    c.classList.add('active');
    AM_FILTER = c.getAttribute('data-astatus');
    renderAddMoneyList();
  });
});
function showAddMoneyDetail(id){
  const r = ADD_MONEY_REQS.find(x=>x.id===id);
  if(!r) return;
  const dt = r.createdAt ? new Date(r.createdAt).toLocaleString('en-GB') : '';
  const proof = r.proofUrl ? `<img class="detail-image" src="${esc(r.proofUrl)}" />` : '<div style="color:var(--muted);font-size:12px;padding:10px;">No proof</div>';
  $('amDetailContent').innerHTML = `
    <div class="detail-row"><span class="dr-label">TrxID</span><span class="dr-value">#${esc(r.trxId||r.id)}</span></div>
    <div class="detail-row"><span class="dr-label">Status</span><span class="dr-value"><span class="badge ${statusClass(r.status)}">${statusLabel(r.status)}</span></span></div>
    <div class="detail-row"><span class="dr-label">Name</span><span class="dr-value">${esc(r.firstName||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Username</span><span class="dr-value">@${esc(r.username||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Telegram ID</span><span class="dr-value">${esc(r.telegramId||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Method</span><span class="dr-value">${esc(r.method||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">TrxID</span><span class="dr-value">${esc(r.userTrxId||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Amount</span><span class="dr-value" style="color:#22c55e;">৳${fmtD(r.amount)}</span></div>
    <div class="detail-row"><span class="dr-label">Date</span><span class="dr-value">${esc(dt)}</span></div>
    <div style="font-size:12px;font-weight:700;margin-top:12px;margin-bottom:6px;">📷 Screenshot</div>
    ${proof}`;
  const s = String(r.status||'pending').toLowerCase();
  let btns = '';
  if(s !== 'completed') btns += `<button class="btn btn-success" onclick="approveAddMoney('${r.id}','${r.telegramId}','${num(r.amount)}')">✅ Approve</button>`;
  if(s !== 'rejected') btns += `<button class="btn btn-danger" onclick="rejectAddMoney('${r.id}')">❌ Reject</button>`;
  btns += `<button class="btn btn-ghost" onclick="deleteAddMoney('${r.id}')">🗑 Delete</button>`;
  $('amActions').innerHTML = btns;
  openModal('amModal');
}
async function approveAddMoney(id, telegramId, amount){
  try{
    await db.ref('addMoneyRequests/' + id).update({ status: 'completed', approvedAt: Date.now() });
    await db.ref('transactions/' + id).update({ status: 'completed', approvedAt: Date.now() });
    const b = await db.ref('users/' + telegramId + '/balance').once('value');
    const c = num(b.val()) || 0;
    await db.ref('users/' + telegramId + '/balance').set(c + num(amount));
    toast('Approved + ৳'+fmtD(amount)+' Balance যোগ হয়েছে','ok');
    closeModal('amModal');
    loadAddMoney();
  }catch(e){ toast('হয়নি','err'); }
}
async function rejectAddMoney(id){
  try{
    await db.ref('addMoneyRequests/' + id).update({ status: 'rejected', rejectedAt: Date.now() });
    await db.ref('transactions/' + id).update({ status: 'rejected', rejectedAt: Date.now() });
    toast('Rejected','ok');
    closeModal('amModal');
    loadAddMoney();
  }catch(e){ toast('হয়নি','err'); }
}
function deleteAddMoney(id){
  confirmAction('Delete?', async ()=>{
    try{ await db.ref('addMoneyRequests/' + id).remove(); closeModal('amModal'); loadAddMoney(); toast('Deleted','ok'); }
    catch(e){ toast('হয়নি','err'); }
  });
}

/* =========================================================
   WITHDRAW
========================================================= */
async function loadWithdraws(){
  const box = $('withdrawList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('withdrawRequests').once('value');
    const data = snap.val() || {};
    WITHDRAW_REQS = Object.keys(data).map(k=>({ id:k, ...data[k] })).sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
    renderWithdrawList();
  }catch(e){}
}
function renderWithdrawList(){
  const box = $('withdrawList');
  let list = WITHDRAW_REQS.slice();
  if(WD_FILTER !== 'all') list = list.filter(x=>x.status === WD_FILTER);
  if(!list.length){ box.innerHTML = '<div class="empty"><div class="eico">💸</div><div class="etxt">Request নেই।</div></div>'; return; }
  box.innerHTML = list.map(r=>{
    const dt = r.createdAt ? new Date(r.createdAt).toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) : '';
    return `<div class="order-item" data-wdid="${esc(r.id)}">
      <div class="order-item-top">
        <div>
          <div class="order-item-id">#${esc(r.trxId||r.id)}</div>
          <div class="order-item-sub">${esc(r.firstName||'')} @${esc(r.username||'-')} • ${esc(dt)}</div>
        </div>
        <span class="badge ${statusClass(r.status)}">${statusLabel(r.status)}</span>
      </div>
      <div class="order-item-grid">
        <div><div class="oi-label">Method</div><div class="oi-value">${esc(r.method||'-')}</div></div>
        <div><div class="oi-label">Number</div><div class="oi-value">${esc(r.number||'-')}</div></div>
        <div><div class="oi-label">Amount</div><div class="oi-value" style="color:#ef4444;">৳${fmtD(r.amount)}</div></div>
      </div>
    </div>`;
  }).join('');
  box.querySelectorAll('[data-wdid]').forEach(el=>{
    el.onclick = ()=> showWithdrawDetail(el.getAttribute('data-wdid'));
  });
}
document.querySelectorAll('#wdFilters .filter-chip').forEach(c=>{
  c.addEventListener('click', ()=>{
    document.querySelectorAll('#wdFilters .filter-chip').forEach(x=>x.classList.remove('active'));
    c.classList.add('active');
    WD_FILTER = c.getAttribute('data-wstatus');
    renderWithdrawList();
  });
});
function showWithdrawDetail(id){
  const r = WITHDRAW_REQS.find(x=>x.id===id);
  if(!r) return;
  const dt = r.createdAt ? new Date(r.createdAt).toLocaleString('en-GB') : '';
  $('wdDetailContent').innerHTML = `
    <div class="detail-row"><span class="dr-label">TrxID</span><span class="dr-value">#${esc(r.trxId||r.id)}</span></div>
    <div class="detail-row"><span class="dr-label">Status</span><span class="dr-value"><span class="badge ${statusClass(r.status)}">${statusLabel(r.status)}</span></span></div>
    <div class="detail-row"><span class="dr-label">Name</span><span class="dr-value">${esc(r.firstName||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Username</span><span class="dr-value">@${esc(r.username||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Telegram ID</span><span class="dr-value">${esc(r.telegramId||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Method</span><span class="dr-value">${esc(r.method||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Number</span><span class="dr-value">${esc(r.number||'-')}</span></div>
    <div class="detail-row"><span class="dr-label">Amount</span><span class="dr-value" style="color:#ef4444;">৳${fmtD(r.amount)}</span></div>
    <div class="detail-row"><span class="dr-label">Date</span><span class="dr-value">${esc(dt)}</span></div>`;
  const s = String(r.status||'pending').toLowerCase();
  let btns = '';
  if(s !== 'completed') btns += `<button class="btn btn-success" onclick="approveWithdraw('${r.id}')">✅ Approve</button>`;
  if(s !== 'rejected') btns += `<button class="btn btn-danger" onclick="rejectWithdraw('${r.id}','${r.telegramId}','${num(r.amount)}')">❌ Reject & Refund</button>`;
  btns += `<button class="btn btn-ghost" onclick="deleteWithdraw('${r.id}')">🗑 Delete</button>`;
  $('wdActions').innerHTML = btns;
  openModal('wdModal');
}
async function approveWithdraw(id){
  try{
    await db.ref('withdrawRequests/' + id).update({ status: 'completed', approvedAt: Date.now() });
    await db.ref('transactions/' + id).update({ status: 'completed', approvedAt: Date.now() });
    toast('Approved','ok'); closeModal('wdModal'); loadWithdraws();
  }catch(e){ toast('হয়নি','err'); }
}
async function rejectWithdraw(id, telegramId, amount){
  try{
    await db.ref('withdrawRequests/' + id).update({ status: 'rejected', rejectedAt: Date.now() });
    await db.ref('transactions/' + id).update({ status: 'rejected', rejectedAt: Date.now() });
    const b = await db.ref('users/' + telegramId + '/balance').once('value');
    const c = num(b.val()) || 0;
    await db.ref('users/' + telegramId + '/balance').set(c + num(amount));
    toast('Rejected + ৳'+fmtD(amount)+' Refunded','ok'); closeModal('wdModal'); loadWithdraws();
  }catch(e){ toast('হয়নি','err'); }
}
function deleteWithdraw(id){
  confirmAction('Delete?', async ()=>{
    try{ await db.ref('withdrawRequests/' + id).remove(); closeModal('wdModal'); loadWithdraws(); toast('Deleted','ok'); }
    catch(e){ toast('হয়নি','err'); }
  });
}

/* =========================================================
   APPS (with Range Builder)
========================================================= */
async function loadApps(){
  const box = $('appsList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('apps').once('value');
    const data = snap.val() || {};
    APPS = Object.keys(data).map(k=>({ id:k, ...data[k] })).sort((a,b)=>{
      const sa = a.status !== false ? 0 : 1;
      const sb = b.status !== false ? 0 : 1;
      if(sa !== sb) return sa - sb;
      return (a.name||'').localeCompare(b.name||'');
    });
    renderApps();
  }catch(e){}
}
function renderApps(){
  const box = $('appsList');
  if(!APPS.length){
    box.innerHTML = `<div class="empty"><div class="eico">💰</div><div class="etxt">App নেই। "⚡ Seed" চাপুন।</div>
      <button class="btn btn-primary btn-icon" onclick="seedDefaults()" style="margin-top:14px;">⚡ Seed</button></div>`;
    return;
  }
  box.innerHTML = APPS.map(a=>{
    const active = a.status !== false;
    const logo = safeUrl(a.logo) || 'https://ui-avatars.com/api/?name='+encodeURIComponent(a.name||'A')+'&background=2f88ff&color=fff';

    let rangeHTML = '';
    if(a.ranges && typeof a.ranges === 'object' && Object.keys(a.ranges).length){
      const rks = Object.keys(a.ranges).sort((x,y)=>{
        const rx = a.ranges[x], ry = a.ranges[y];
        return (rx.min||0) - (ry.min||0);
      });
      rangeHTML = '<div style="background:#f7f9fc;border-radius:10px;padding:10px;margin-bottom:10px;border:1px solid #e2e8f0;">'
        + '<div style="font-size:10.5px;font-weight:800;color:#1e40af;margin-bottom:8px;">📊 '+rks.length+' Ranges</div>'
        + rks.map(rk=>{
          const r = a.ranges[rk];
          const lbl = r.label || (fmt(r.min)+' - '+fmt(r.max));
          return '<div style="display:flex;justify-content:space-between;align-items:center;font-size:11.5px;padding:4px 0;border-bottom:1px dashed #e2e8f0;">'
            + '<span style="color:var(--muted);font-weight:700;">'+esc(lbl)+'</span>'
            + '<span style="font-weight:900;color:#22c55e;">৳'+fmtD(r.rate)+'</span>'
            + '</div>';
        }).join('')
        + '</div>';
    }

    return `<div class="card">
      <div class="card-head">
        <div class="card-title">
          <img src="${esc(logo)}" />
          <div class="card-title-text">
            <div class="ct-name">${esc(a.name||'App')}</div>
            <div class="ct-sub">Per ${fmt(a.ratePer||1000)} Coins • Min ${fmt(a.minimumCoin)}</div>
          </div>
        </div>
        <span class="badge ${active?'badge-active':'badge-stop'}">${active?'Active':'Stop'}</span>
      </div>
      <div style="font-size:11.5px;color:var(--muted);margin-bottom:10px;">📤 ${esc(a.receivingAccount||'-')}</div>
      ${rangeHTML}
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button class="btn ${active?'btn-danger':'btn-success'} btn-icon" onclick="toggleApp('${a.id}', ${active})">${active?'🔴 Stop':'🟢 Active'}</button>
        <button class="btn btn-primary btn-icon" onclick="editApp('${a.id}')">✏️ Edit</button>
        <button class="btn btn-ghost btn-icon" onclick="deleteApp('${a.id}')">🗑 Delete</button>
      </div>
    </div>`;
  }).join('');
}

/* APP RANGES BUILDER */
function addAppRangeRow(data){
  const d = data || { min:'', max:'', rate:'', label:'' };
  APP_RANGES.push({ min: d.min, max: d.max, rate: d.rate, label: d.label || '' });
  renderAppRangesBuilder();
}
function removeAppRangeRow(idx){
  APP_RANGES.splice(idx, 1);
  renderAppRangesBuilder();
}
function fillDefaultAppRanges(){
  APP_RANGES = DEFAULT_RANGE_TEMPLATE.map(r=>({ ...r }));
  renderAppRangesBuilder();
  toast('Default ৪টি Range যোগ হয়েছে','ok');
}
function renderAppRangesBuilder(){
  const box = $('appRangesBuilder');
  if(!box) return;
  if(!APP_RANGES.length){
    box.innerHTML = '<div style="text-align:center;padding:16px;color:var(--muted);font-size:12px;">কোনো Range নেই। নিচের বাটনে ক্লিক করুন।</div>';
    return;
  }
  box.innerHTML = APP_RANGES.map((r, i)=>{
    return `<div class="range-builder-row">
      <div>
        <div class="rb-label">Min Coin</div>
        <input type="number" value="${esc(r.min)}" placeholder="10000"
          oninput="APP_RANGES[${i}].min=this.value; autoLabelRange(${i})" />
      </div>
      <div>
        <div class="rb-label">Max Coin</div>
        <input type="number" value="${esc(r.max)}" placeholder="100000"
          oninput="APP_RANGES[${i}].max=this.value; autoLabelRange(${i})" />
      </div>
      <div>
        <div class="rb-label">Rate (৳)</div>
        <input type="number" step="0.01" value="${esc(r.rate)}" placeholder="10"
          oninput="APP_RANGES[${i}].rate=this.value" />
      </div>
      <div>
        <div class="rb-label">Label</div>
        <input type="text" value="${esc(r.label)}" placeholder="10K - 100K"
          oninput="APP_RANGES[${i}].label=this.value" />
      </div>
      <button class="rb-del" onclick="removeAppRangeRow(${i})" type="button">✕</button>
    </div>`;
  }).join('');
}
function autoLabelRange(i){
  const r = APP_RANGES[i];
  if(!r) return;
  const min = num(r.min), max = num(r.max);
  if(!min || !max) return;
  const fmtShort = (n)=>{
    if(n >= 1000000) return (n/1000000).toFixed(n % 1000000 === 0 ? 0 : 1) + 'M';
    if(n >= 1000) return (n/1000).toFixed(n % 1000 === 0 ? 0 : 1) + 'K';
    return String(n);
  };
  r.label = fmtShort(min) + ' - ' + fmtShort(max);
  const rows = $('appRangesBuilder').querySelectorAll('.range-builder-row');
  if(rows[i]){
    const inputs = rows[i].querySelectorAll('input');
    if(inputs[3]) inputs[3].value = r.label;
  }
}
function collectAppRanges(){
  const cleaned = [];
  for(let i=0;i<APP_RANGES.length;i++){
    const r = APP_RANGES[i];
    const min = num(r.min), max = num(r.max), rate = num(r.rate);
    if(min > 0 && max > 0 && rate > 0 && max > min){
      cleaned.push({
        min, max, rate,
        label: r.label || (min + ' - ' + max)
      });
    }
  }
  return cleaned;
}

function openAppModal(){
  $('appModalTitle').textContent = '➕ Add Coin App';
  $('app_id').value = '';
  $('app_name').value = '';
  $('app_ratePer').value = '1000';
  $('app_color').value = 'blue';
  $('app_receivingAccount').value = '';
  $('app_description').value = '';
  $('app_status').checked = true;
  IMG_STORE.app_logo = '';
  if($('app_logo_preview')) $('app_logo_preview').classList.remove('show');
  if($('app_logo_wrap')) $('app_logo_wrap').classList.remove('has-image');

  APP_RANGES = DEFAULT_RANGE_TEMPLATE.map(r=>({ ...r }));
  renderAppRangesBuilder();

  openModal('appModal');
}

function editApp(id){
  const a = APPS.find(x=>x.id===id);
  if(!a) return;
  $('appModalTitle').textContent = '✏️ Edit App';
  $('app_id').value = a.id;
  $('app_name').value = a.name || '';
  $('app_ratePer').value = a.ratePer || 1000;
  $('app_color').value = a.color || 'blue';
  $('app_receivingAccount').value = a.receivingAccount || '';
  $('app_description').value = a.description || '';
  $('app_status').checked = a.status !== false;
  setImagePreview('app_logo', a.logo || '');

  APP_RANGES = [];
  if(a.ranges && typeof a.ranges === 'object'){
    const rks = Object.keys(a.ranges).sort((x,y)=>{
      const rx = a.ranges[x], ry = a.ranges[y];
      return (rx.min||0) - (ry.min||0);
    });
    rks.forEach(k=>{
      const r = a.ranges[k] || {};
      APP_RANGES.push({
        min: r.min || '',
        max: r.max || '',
        rate: r.rate || '',
        label: r.label || ''
      });
    });
  }
  if(!APP_RANGES.length){
    APP_RANGES = DEFAULT_RANGE_TEMPLATE.map(r=>({ ...r }));
  }
  renderAppRangesBuilder();

  openModal('appModal');
}

async function saveApp(){
  const existingId = ($('app_id').value || '').trim();
  const id = existingId || ('app_' + Date.now());
  const name = $('app_name').value.trim();
  if(!name){ toast('Name দিন','err'); return; }

  const ranges = collectAppRanges();
  if(!ranges.length){
    toast('কমপক্ষে একটি Range দিন','err');
    return;
  }

  const rangesObj = {};
  ranges.forEach((r, i)=>{
    rangesObj['r' + (i+1)] = r;
  });

  const minCoin = Math.min(...ranges.map(r=>r.min));
  const lowestRate = Math.min(...ranges.map(r=>r.rate));

  const payload = {
    name,
    logo: IMG_STORE.app_logo || '',
    rate: lowestRate,
    ratePer: num($('app_ratePer').value) || 1000,
    minimumCoin: minCoin,
    receivingAccount: $('app_receivingAccount').value.trim(),
    description: $('app_description').value.trim(),
    color: $('app_color').value,
    status: $('app_status').checked,
    ranges: rangesObj,
    rangeCount: ranges.length,
    updatedAt: Date.now()
  };
  if(!existingId) payload.createdAt = Date.now();

  try{
    if(existingId) await db.ref('apps/' + id).update(payload);
    else await db.ref('apps/' + id).set(payload);
    toast('Save হয়েছে ✅','ok');
    closeModal('appModal');
    loadApps();
  }catch(e){ console.error(e); toast('Save হয়নি','err'); }
}

async function toggleApp(id, isActive){
  try{ await db.ref('apps/' + id).update({ status: !isActive }); loadApps(); }
  catch(e){ toast('হয়নি','err'); }
}
function deleteApp(id){
  confirmAction('App Delete?', async ()=>{
    try{ await db.ref('apps/'+id).remove(); loadApps(); toast('Deleted','ok'); }
    catch(e){ toast('হয়নি','err'); }
  });
}

