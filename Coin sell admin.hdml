  <div class="tab-content" id="tab-settings">
    <div class="section-title"><div class="st-left">⚙️ Site Settings</div></div>
    <div class="card">
      <div class="form-row"><label>App Name</label><input type="text" id="s_appName" class="form-input" /></div>
      <div class="form-row"><label>Tagline</label><input type="text" id="s_tagline" class="form-input" /></div>
      <div class="form-row">
        <label>Logo</label>
        <div class="file-upload-wrap" id="s_logo_wrap" onclick="document.getElementById('s_logo_file').click()">
          <div class="file-upload-icon">🖼️</div>
          <div class="file-upload-info">
            <div class="file-upload-title">Tap to Upload Logo</div>
            <div class="file-upload-sub">Max 15 MB (Auto Compress)</div>
          </div>
        </div>
        <input type="file" id="s_logo_file" accept="image/*" style="display:none;" onchange="handleImageUpload(event, 's_logo')" />
        <div class="file-preview" id="s_logo_preview">
          <img id="s_logo_preview_img" />
          <button class="file-preview-remove" onclick="removeImagePreview('s_logo')" type="button">✕</button>
        </div>
      </div>
      <div class="form-row">
        <label>Splash Image</label>
        <div class="file-upload-wrap" id="s_splashImage_wrap" onclick="document.getElementById('s_splashImage_file').click()">
          <div class="file-upload-icon">🚀</div>
          <div class="file-upload-info">
            <div class="file-upload-title">Tap to Upload Splash</div>
            <div class="file-upload-sub">Max 15 MB</div>
          </div>
        </div>
        <input type="file" id="s_splashImage_file" accept="image/*" style="display:none;" onchange="handleImageUpload(event, 's_splashImage')" />
        <div class="file-preview" id="s_splashImage_preview">
          <img id="s_splashImage_preview_img" />
          <button class="file-preview-remove" onclick="removeImagePreview('s_splashImage')" type="button">✕</button>
        </div>
      </div>
      <div class="form-row"><label>Support Channel URL</label><input type="url" id="s_supportChannelUrl" class="form-input" /></div>
      <div class="form-row"><label>Join Button Text</label><input type="text" id="s_joinBtnText" class="form-input" /></div>
      <div class="form-row"><label>Send Money Fee (৳)</label><input type="number" id="s_sendMoneyFee" class="form-input" /></div>
      <div class="form-row"><label>Meta Account Default Price (৳)</label><input type="number" step="0.01" id="s_metaDefaultPrice" class="form-input" value="0.50" /></div>
      <div class="form-row"><label>Notice</label><textarea id="s_notice" class="form-textarea"></textarea></div>
      <div class="form-row"><label>Contact Info</label><input type="text" id="s_contactInfo" class="form-input" /></div>
      <div class="form-row"><label>Footer Text</label><input type="text" id="s_footerText" class="form-input" /></div>
      <div class="form-row">
        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
          <input type="checkbox" id="s_maintenanceMode" style="width:auto;" />
          <span>🔧 Maintenance Mode</span>
        </label>
      </div>
      <div class="form-row"><label>Maintenance Message</label><textarea id="s_maintenanceText" class="form-textarea"></textarea></div>
      <button class="btn btn-primary btn-block" onclick="saveSettings()">💾 Save Settings</button>
    </div>
  </div>

</div>

<!-- CATEGORY MODAL -->
<div class="modal" id="categoryModal">
  <div class="modal-content" style="max-width:480px;">
    <div class="modal-head">
      <div class="modal-title" id="categoryModalTitle">➕ Add Category</div>
      <button class="modal-close" onclick="closeModal('categoryModal')">✕</button>
    </div>
    <input type="hidden" id="cat_id" />
    <div class="form-row">
      <label>Category Name *</label>
      <input type="text" id="cat_name" class="form-input" placeholder="Proxy / VPN / Meta Account" oninput="autoDetectIcon()" />
    </div>
    <div class="form-row">
      <label>Icon (Emoji) *</label>
      <input type="text" id="cat_icon" class="form-input" placeholder="🌐" maxlength="4" />
    </div>
    <div class="form-row">
      <label>Category Type *</label>
      <select id="cat_type" class="form-select">
        <option value="proxy">🌐 Proxy (Host, Port, User, Pass)</option>
        <option value="vpn">🔒 VPN (Email, Password)</option>
        <option value="package">📦 Package Only</option>
        <option value="meta">🎭 Meta Account Sell (Google Sheet)</option>
      </select>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('categoryModal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveCategory()">💾 Save</button>
    </div>
  </div>
</div>

<!-- SHOP PRODUCT MODAL -->
<div class="modal" id="shopModal">
  <div class="modal-content">
    <div class="modal-head">
      <div class="modal-title" id="shopModalTitle">➕ Add Product</div>
      <button class="modal-close" onclick="closeModal('shopModal')">✕</button>
    </div>
    <input type="hidden" id="shop_id" />
    <div class="form-row">
      <label>Category *</label>
      <select id="shop_category" class="form-select" onchange="updateProductFields()">
        <option value="">-- Loading --</option>
      </select>
    </div>
    <div class="form-row">
      <label>Product Name *</label>
      <input type="text" id="shop_name" class="form-input" placeholder="Product Name" />
    </div>
    <div class="form-row">
      <label>Logo *</label>
      <div class="file-upload-wrap" id="shop_logo_wrap" onclick="document.getElementById('shop_logo_file').click()">
        <div class="file-upload-icon">🖼️</div>
        <div class="file-upload-info">
          <div class="file-upload-title">Tap to Upload Logo</div>
          <div class="file-upload-sub">Max 15 MB</div>
        </div>
      </div>
      <input type="file" id="shop_logo_file" accept="image/*" style="display:none;" onchange="handleImageUpload(event, 'shop_logo')" />
      <div class="file-preview" id="shop_logo_preview">
        <img id="shop_logo_preview_img" />
        <button class="file-preview-remove" onclick="removeImagePreview('shop_logo')" type="button">✕</button>
      </div>
    </div>
    <div class="form-row">
      <label>Brand / By *</label>
      <input type="text" id="shop_proxyBy" class="form-input" placeholder="Garena / Rapid / Admin" />
    </div>
    <div class="cat-fields-section" id="dynamicFieldsSection" style="display:none;">
      <div class="cfs-title" id="dynamicFieldsTitle">📋 Details</div>
      <div id="dynamicFieldsContainer"></div>
    </div>
    <div class="form-row">
      <label>📦 Packages (Name + Price) *</label>
      <div class="pkg-builder" id="pkgBuilder"></div>
      <button class="btn btn-ghost btn-icon" onclick="addPkgRow()" type="button" style="margin-top:6px;">➕ Add Package</button>
    </div>
    <div class="form-row">
      <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
        <input type="checkbox" id="shop_status" checked style="width:auto;" />
        <span>Active</span>
      </label>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('shopModal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveShopItem()">💾 Save</button>
    </div>
  </div>
</div>

<!-- META PRODUCT MODAL -->
<div class="modal" id="metaModal">
  <div class="modal-content">
    <div class="modal-head">
      <div class="modal-title" id="metaModalTitle">➕ Add Meta Product</div>
      <button class="modal-close" onclick="closeModal('metaModal')">✕</button>
    </div>
    <input type="hidden" id="meta_id" />
    <div class="form-row">
      <label>Product Name *</label>
      <input type="text" id="meta_name" class="form-input" placeholder="Meta Account (Facebook) - USA" />
    </div>
    <div class="form-row">
      <label>Logo *</label>
      <div class="file-upload-wrap" id="meta_logo_wrap" onclick="document.getElementById('meta_logo_file').click()">
        <div class="file-upload-icon">🖼️</div>
        <div class="file-upload-info">
          <div class="file-upload-title">Tap to Upload Logo</div>
          <div class="file-upload-sub">Max 15 MB (Auto Compress)</div>
        </div>
      </div>
      <input type="file" id="meta_logo_file" accept="image/*" style="display:none;" onchange="handleImageUpload(event, 'meta_logo')" />
      <div class="file-preview" id="meta_logo_preview">
        <img id="meta_logo_preview_img" />
        <button class="file-preview-remove" onclick="removeImagePreview('meta_logo')" type="button">✕</button>
      </div>
    </div>
    <div class="form-row">
      <label>Category (Meta Type) *</label>
      <select id="meta_category" class="form-select">
        <option value="">-- Select Meta Category --</option>
      </select>
    </div>
    <div class="form-row">
      <label>Google Sheet URL <span style="color:var(--muted);font-weight:500;">(Public CSV Link)</span></label>
      <input type="url" id="meta_sheetUrl" class="form-input" placeholder="https://docs.google.com/spreadsheets/d/xxxxx/export?format=csv" />
      <div class="cfs-hint">💡 Google Sheet → File → Share → Publish to web → CSV। Column: <b>username, password</b></div>
    </div>
    <div class="form-grid-2">
      <div class="form-row"><label>Price Per Account (৳) *</label>
        <input type="number" step="0.01" id="meta_price" class="form-input" value="0.50" />
      </div>
      <div class="form-row"><label>Status</label>
        <select id="meta_status" class="form-select">
          <option value="active">🟢 Active</option>
          <option value="hidden">🔴 Hidden</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <label>Description</label>
      <textarea id="meta_description" class="form-textarea" placeholder="Meta account details, country, etc."></textarea>
    </div>
    <div class="cat-fields-section">
      <div class="cfs-title">📋 Manual Account List (ঐচ্ছিক)</div>
      <div class="cfs-hint" style="margin-bottom:10px;">Google Sheet না থাকলে নিচে ম্যানুয়ালি ইউজারনেম/পাসওয়ার্ড যোগ করুন। প্রতি লাইনে একটি: <code>username,password</code></div>
      <textarea id="meta_manualAccounts" class="form-textarea" style="min-height:120px;font-family:monospace;font-size:12px;" placeholder="user1@mail.com,pass123
user2@mail.com,pass456
user3@mail.com,pass789"></textarea>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal('metaModal')">Cancel</button>
      <button class="btn btn-primary" onclick="saveMetaProduct()">💾 Save</button>
    </div>
  </div>
</div>

