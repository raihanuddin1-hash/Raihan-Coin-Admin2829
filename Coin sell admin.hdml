<!-- APP MODAL -->
<div class="modal" id="appModal">
  <div class="modal-content">
    <div class="modal-head">
      <div class="modal-title" id="appModalTitle">➕ Add Coin App</div>
      <button class="modal-close" onclick="closeModal('appModal')">✕</button>
    </div>
    <input type="hidden" id="app_id" />
    <div class="form-row"><label>App Name *</label><input type="text" id="app_name" class="form-input" /></div>
    <div class="form-row">
      <label>Logo *</label>
      <div class="file-upload-wrap" id="app_logo_wrap" onclick="document.getElementById('app_logo_file').click()">
        <div class="file-upload-icon">🖼️</div>
        <div class="file-upload-info">
          <div class="file-upload-title">Tap to Upload Logo</div>
          <div class="file-upload-sub">Max 15 MB</div>
        </div>
      </div>
      <input type="file" id="app_logo_file" accept="image/*" style="display:none;" onchange="handleImageUpload(event, 'app_logo')" />
      <div class="file-preview" id="app_logo_preview">
        <img id="app_logo_preview_img" />
        <button class="file-preview-remove" onclick="removeImagePreview('app_logo')" type="button">✕</button>
      </div>
    </div>
    <div class="form-grid-2">
      <div class="form-row"><label>Rate Per (Coins) *</label><input type="number" id="app_ratePer" class="form-input" value="1000" /></div>
      <div class="form-row"><label>Color</label>
        <select id="app_color" class="form-select">
          <option value="blue">Blue</option>
          <option value="green">Green</option>
          <option value="orange">Orange</option>
          <option value="purple">Purple</option>
        </select>
      </div>
    </div>
    <div class="form-row"><label>Receiving Account</label><input type="text" id="app_receivingAccount" class="form-input" /></div>

    <!-- RANGE BUILDER -->
    <div class="cat-fields-section" style="background:linear-gradient(135deg,#eff6ff,#f7faff);border-color:#bfdbfe;">
      <div class="cfs-title" style="color:#1e40af;">📊 Price Ranges (৪টি Range) *</div>
      <div class="cfs-hint" style="color:#1e40af;margin-bottom:12px;">
        ?? ইউজার Coin Sell করার সময় এই Range গুলো থেকে সিলেক্ট করবে। Min – Max Coins এর মধ্যে Rate apply হবে।
      </div>
      <div id="appRangesBuilder"></div>
      <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
        <button class="btn btn-purple btn-icon" onclick="addAppRangeRow()" type="button">➕ Add Range</button>
        <button class="btn btn-ghost btn-icon" onclick="fillDefaultAppRanges()" type="button">⚡ Default ৪টি</button>
      </div>
    </div>

    <div class="form-row"><label>Description</label><textarea id="app_description" class="form-textarea"></textarea></div>
