<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#f4f6fb" />
<title>🔐 Admin — GBS BD COIN BAY</title>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
<style>
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
:root{
  --bg:#f4f6fb; --card:#ffffff; --border:#e8ecf5;
  --text:#0e1533; --muted:#7a8ba8;
  --primary:#2f88ff;
  --success:#22c55e; --success-bg:#dcfce7;
  --danger:#ef4444; --danger-bg:#fee2e2;
  --warning:#f59e0b; --warning-bg:#fef3c7;
  --purple:#8b5cf6; --purple-bg:#ede9fe;
  --grad-blue:linear-gradient(135deg,#2f88ff 0%,#5aa4ff 100%);
  --grad-purple:linear-gradient(135deg,#8b5cf6,#a855f7);
  --grad-green:linear-gradient(135deg,#22c55e,#16a34a);
  --grad-orange:linear-gradient(135deg,#f59e0b,#f97316);
  --grad-red:linear-gradient(135deg,#ef4444,#dc2626);
}
html,body{
  font-family:'Inter','Segoe UI','Hind Siliguri',system-ui,sans-serif;
  background:var(--bg); color:var(--text);
  min-height:100vh; font-size:14px; line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
img{ display:block; max-width:100%; }
button{ font-family:inherit; cursor:pointer; border:none; outline:none; }
input,textarea,select{ font-family:inherit; outline:none; border:none; }
::-webkit-scrollbar{ width:8px; height:8px; }
::-webkit-scrollbar-thumb{ background:#cbd5e1; border-radius:4px; }

/* LOGIN */
.login-screen{
  position:fixed; inset:0; z-index:9999;
  background:linear-gradient(160deg,#fff 0%,#e8f0ff 50%,#fff 100%);
  display:flex; align-items:center; justify-content:center; padding:20px;
}
.login-box{
  background:#fff; border:1px solid var(--border);
  border-radius:24px; padding:34px 26px;
  max-width:420px; width:100%; text-align:center;
  box-shadow:0 20px 60px rgba(47,136,255,0.15);
  position:relative; overflow:hidden;
}
.login-box::before{
  content:''; position:absolute; top:0; left:0; right:0; height:5px;
  background:linear-gradient(90deg,#2f88ff,#8b5cf6,#22c55e,#f59e0b);
}
.login-logo{
  width:80px; height:80px; border-radius:22px;
  background:var(--grad-blue);
  display:flex; align-items:center; justify-content:center;
  font-size:42px; margin:0 auto 20px;
}
.login-title{ font-size:24px; font-weight:800; margin-bottom:6px; }
.login-sub{ font-size:13px; color:var(--muted); margin-bottom:26px; }
.login-input{
  width:100%; background:#f7f9fc; border:1.5px solid #e2e8f0;
  border-radius:12px; padding:14px 16px;
  font-size:15px; text-align:center; letter-spacing:2px;
  margin-bottom:14px;
}
.login-input:focus{ border-color:var(--primary); background:#fff; }
.login-error{ color:var(--danger); font-size:12px; font-weight:600; margin-bottom:12px; display:none; }
.login-btn{
  width:100%; padding:14px; border-radius:12px;
  background:var(--grad-blue); color:#fff;
  font-size:15px; font-weight:800;
}

#adminApp{ display:none; min-height:100vh; padding-bottom:80px; }
#adminApp.active{ display:block; }

/* TOPBAR */
.topbar{
  background:#fff; border-bottom:1px solid var(--border);
  padding:14px 16px;
  display:flex; align-items:center; justify-content:space-between;
  position:sticky; top:0; z-index:50;
}
.topbar-title{ display:flex; align-items:center; gap:10px; font-size:16px; font-weight:800; }
.topbar-title .tico{
  width:38px; height:38px; border-radius:11px;
  background:var(--grad-blue);
  display:flex; align-items:center; justify-content:center;
  font-size:19px;
}
.logout-btn{
  background:var(--danger-bg); color:var(--danger);
  padding:8px 14px; border-radius:10px;
  font-size:12px; font-weight:700;
}

/* TABS */
.tabs{
  display:flex; gap:6px; padding:12px;
  overflow-x:auto; position:sticky; top:66px; z-index:49;
  background:var(--bg);
}
.tabs::-webkit-scrollbar{ display:none; }
.tab-btn{
  flex-shrink:0; background:#fff; color:var(--muted);
  padding:9px 16px; border-radius:20px;
  font-size:12.5px; font-weight:700;
  border:1.5px solid var(--border);
  white-space:nowrap; display:flex; align-items:center; gap:6px;
}
.tab-btn.active{
  background:var(--grad-blue); color:#fff; border-color:transparent;
}
.tab-content{ display:none; padding:16px; }
.tab-content.active{ display:block; }

.stats-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-bottom:20px; }
@media(min-width:720px){ .stats-grid{ grid-template-columns:repeat(4,1fr); } }
.stat-box{
  background:#fff; border:1px solid var(--border);
  border-radius:16px; padding:16px;
  position:relative; overflow:hidden;
}
.stat-box::before{
  content:''; position:absolute; top:0; left:0; right:0; height:3px;
  background:var(--grad-blue);
}
.stat-box[data-color="green"]::before{ background:var(--grad-green); }
.stat-box[data-color="orange"]::before{ background:var(--grad-orange); }
.stat-box[data-color="red"]::before{ background:var(--grad-red); }
.stat-box[data-color="purple"]::before{ background:var(--grad-purple); }
.stat-icon{ font-size:22px; margin-bottom:8px; }
.stat-val{ font-size:24px; font-weight:900; }
.stat-lbl{ font-size:11px; color:var(--muted); margin-top:3px; font-weight:600; }

.section-title{
  font-size:16px; font-weight:800;
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:14px; flex-wrap:wrap; gap:8px;
}
.section-title .st-left{ display:flex; align-items:center; gap:9px; }
.section-title .st-left::before{
  content:''; width:4px; height:20px;
  background:var(--grad-blue); border-radius:2px;
}

.card{
  background:#fff; border:1px solid var(--border);
  border-radius:16px; padding:16px; margin-bottom:12px;
}
.card-head{
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:12px; gap:10px; flex-wrap:wrap;
}
.card-title{
  font-size:15px; font-weight:800;
  display:flex; align-items:center; gap:10px;
  min-width:0; flex:1;
}
.card-title img{
  width:42px; height:42px; border-radius:12px;
  object-fit:cover; flex-shrink:0;
  border:1px solid var(--border);
}
.card-title-text{ display:flex; flex-direction:column; min-width:0; }
.card-title-text .ct-name{ white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.card-title-text .ct-sub{ font-size:11px; color:var(--muted); margin-top:2px; }

.badge{
  display:inline-flex; align-items:center; gap:5px;
  padding:4px 10px; border-radius:20px;
  font-size:10.5px; font-weight:700;
}
.badge-active{ background:var(--success-bg); color:var(--success); }
.badge-stop{ background:var(--danger-bg); color:var(--danger); }
.badge-pending{ background:var(--warning-bg); color:#a16207; }
.badge-processing{ background:#dbeafe; color:#1d4ed8; }
.badge-completed{ background:var(--success-bg); color:#15803d; }
.badge-rejected{ background:var(--danger-bg); color:#b91c1c; }
.badge-cancelled{ background:#f1f5f9; color:#64748b; }
.badge-sold{ background:#f3e8ff; color:#7e22ce; }
.badge-cat{ background:#fce7f3; color:#be185d; }
.badge-meta{ background:linear-gradient(135deg,#e0e7ff,#c7d2fe); color:#3730a3; }

.btn{
  padding:10px 16px; border-radius:10px;
  font-size:12.5px; font-weight:700;
  display:inline-flex; align-items:center; justify-content:center; gap:6px;
  font-family:inherit;
}
.btn-primary{ background:var(--grad-blue); color:#fff; }
.btn-success{ background:var(--success-bg); color:var(--success); }
.btn-danger{ background:var(--danger-bg); color:var(--danger); }
.btn-warning{ background:var(--warning-bg); color:#a16207; }
.btn-purple{ background:var(--purple-bg); color:var(--purple); }
.btn-ghost{ background:#f1f5f9; color:#3a4a68; border:1px solid var(--border); }
.btn-block{ width:100%; padding:14px; }
.btn-icon{ padding:8px 12px; font-size:12px; }

.form-row{ margin-bottom:14px; }
.form-row label{
  display:block; font-size:12px; font-weight:700;
  color:#3a4a68; margin-bottom:6px;
}
.form-input, .form-textarea, .form-select{
  width:100%; background:#f7f9fc;
  border:1.5px solid #e2e8f0; border-radius:10px;
  padding:11px 13px; font-size:13.5px; font-weight:500;
}
.form-input:focus, .form-textarea:focus, .form-select:focus{
  border-color:var(--primary); background:#fff;
}
.form-textarea{ resize:vertical; min-height:70px; font-family:inherit; }
.form-grid-2{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }

.category-list{
  display:grid; grid-template-columns:repeat(2,1fr);
  gap:10px; margin-bottom:14px;
}
@media(min-width:600px){ .category-list{ grid-template-columns:repeat(3,1fr); } }
.category-card{
  background:#fff; border:1.5px solid var(--border);
  border-radius:14px; padding:12px;
  text-align:center; cursor:pointer;
  position:relative;
}
.category-card .cc-ico{ font-size:26px; margin-bottom:6px; }
.category-card .cc-name{
  font-size:12.5px; font-weight:800;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.category-card .cc-count{ font-size:10px; color:var(--muted); margin-top:3px; font-weight:700; }
.category-card .cc-del{
  position:absolute; top:6px; right:6px;
  width:22px; height:22px; border-radius:50%;
  background:var(--danger-bg); color:var(--danger);
  display:flex; align-items:center; justify-content:center;
  font-size:12px; border:none; cursor:pointer; font-family:inherit;
}

.file-upload-wrap{
  display:flex; gap:10px; align-items:flex-start;
  padding:12px; background:#f7f9fc;
  border:1.5px dashed #cbd5e1; border-radius:12px;
  cursor:pointer;
}
.file-upload-wrap.has-image{ background:#fff; border-style:solid; border-color:var(--success); }
.file-upload-icon{
  width:44px; height:44px; border-radius:12px;
  background:var(--grad-purple);
  display:flex; align-items:center; justify-content:center;
  font-size:22px; color:#fff; flex-shrink:0;
}
.file-upload-info{ flex:1; min-width:0; }
.file-upload-title{ font-size:13px; font-weight:800; }
.file-upload-sub{ font-size:11px; color:var(--muted); margin-top:3px; font-weight:500; }
.file-preview{
  margin-top:10px; padding:10px; background:#fff;
  border:1px solid var(--border); border-radius:12px;
  position:relative; display:none;
}
.file-preview.show{ display:block; }
.file-preview img{ width:100%; max-height:180px; object-fit:contain; border-radius:8px; }
.file-preview-remove{
  position:absolute; top:16px; right:16px;
  width:32px; height:32px; border-radius:50%;
  background:rgba(239,68,68,0.9); color:#fff;
  font-size:16px; display:flex; align-items:center; justify-content:center;
  border:2px solid #fff; cursor:pointer; font-family:inherit;
}

.filters{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
.filter-chip{
  background:#fff; color:var(--muted);
  padding:8px 14px; border-radius:20px;
  font-size:11.5px; font-weight:700;
  border:1.5px solid var(--border); font-family:inherit;
}
.filter-chip.active{ background:var(--primary); color:#fff; border-color:transparent; }
.search-box{
  width:100%; background:#fff;
  border:1.5px solid var(--border); border-radius:12px;
  padding:11px 14px; font-size:13px;
  margin-bottom:14px; font-family:inherit;
}

.order-item{
  background:#fff; border:1px solid var(--border);
  border-radius:14px; padding:14px; margin-bottom:10px;
  cursor:pointer;
}
.order-item-top{
  display:flex; justify-content:space-between;
  align-items:flex-start; gap:10px; margin-bottom:10px;
}
.order-item-id{ font-size:12px; font-weight:800; color:var(--primary); }
.order-item-sub{ font-size:11px; color:var(--muted); margin-top:2px; }
.order-item-grid{
  display:grid; grid-template-columns:repeat(3,1fr); gap:8px;
  padding-top:10px; border-top:1px dashed var(--border); font-size:11.5px;
}
.oi-label{ color:var(--muted); font-size:10px; margin-bottom:2px; font-weight:600; }
.oi-value{ font-weight:700; }

.modal{
  position:fixed; inset:0; z-index:1000;
  background:rgba(15,23,42,0.55); backdrop-filter:blur(8px);
  display:none; align-items:center; justify-content:center; padding:16px;
}
.modal.show{ display:flex; }
.modal-content{
  background:#fff; border:1px solid var(--border);
  border-radius:20px; max-width:600px; width:100%;
  max-height:90vh; overflow-y:auto; padding:22px;
}
.modal-head{
  display:flex; justify-content:space-between; align-items:center;
  margin-bottom:18px;
}
.modal-title{ font-size:17px; font-weight:800; }
.modal-close{
  width:34px; height:34px; border-radius:50%;
  background:#f1f5f9; color:var(--text);
  display:flex; align-items:center; justify-content:center;
  font-size:16px; font-family:inherit;
}
.modal-actions{ display:flex; gap:10px; margin-top:18px; flex-wrap:wrap; }
.modal-actions .btn{ flex:1; padding:13px; font-size:13.5px; min-width:100px; }

.detail-row{
  display:flex; justify-content:space-between;
  padding:9px 0; border-bottom:1px solid var(--border); font-size:12.5px;
}
.detail-row:last-child{ border-bottom:none; }
.detail-row .dr-label{ color:var(--muted); font-weight:600; flex-shrink:0; }
.detail-row .dr-value{ font-weight:700; text-align:right; word-break:break-all; max-width:60%; }
.detail-image{
  width:100%; max-height:280px; object-fit:contain;
  border-radius:12px; border:1px solid var(--border);
  background:#f7f9fc; margin-top:8px;
}

.pkg-builder{ margin-top:10px; }
.pkg-builder-row{
  display:grid; grid-template-columns:1fr 1fr auto;
  gap:8px; margin-bottom:8px; align-items:center;
}
.pkg-builder-row input{ padding:9px 11px; font-size:13px; }

.cat-fields-section{
  background:#f7f9fc;
  border:1.5px solid #e2e8f0;
  border-radius:12px;
  padding:14px;
  margin-bottom:14px;
}
.cat-fields-section .cfs-title{
  font-size:13px; font-weight:800; color:var(--primary);
  margin-bottom:10px;
  display:flex; align-items:center; gap:6px;
}
.cat-fields-section .cfs-hint{
  font-size:11px; color:var(--muted); margin-top:4px;
}

#toast{
  position:fixed; top:20px; left:50%;
  transform:translateX(-50%) translateY(-100px);
  z-index:9999; background:#0e1533; color:#fff;
  border-radius:12px; padding:12px 18px;
  font-size:13px; font-weight:700;
  box-shadow:0 16px 40px rgba(0,0,0,0.25);
  transition:.35s; display:flex; align-items:center; gap:9px;
  max-width:90vw;
}
#toast.show{ transform:translateX(-50%) translateY(0); }
#toast.ok{ background:#15803d; }
#toast.err{ background:#b91c1c; }
#toast.info{ background:#1e40af; }

.empty{
  padding:44px 20px; text-align:center;
  color:var(--muted); background:#fff;
  border:1px solid var(--border); border-radius:16px;
}
.empty .eico{ font-size:44px; margin-bottom:10px; opacity:.5; }
.empty .etxt{ font-size:13px; font-weight:600; }

.sk{
  background:linear-gradient(90deg,#e9eef7 25%,#f4f6fb 50%,#e9eef7 75%);
  background-size:200% 100%;
  animation:skl 1.4s infinite; border-radius:12px;
}
@keyframes skl{ 0%{ background-position:200% 0; } 100%{ background-position:-200% 0; } }
.sk-block{ height:88px; margin-bottom:12px; }

.tip-box{
  background:linear-gradient(135deg,#eff6ff,#dbeafe);
  border:1px solid #bfdbfe; border-radius:12px;
  padding:12px; margin-bottom:14px;
  font-size:12px; color:#1e40af; line-height:1.6;
}
.tip-box b{ color:#1e3a8a; }
.tip-box code{
  background:#1e3a8a; color:#fff;
  padding:2px 6px; border-radius:4px;
  font-size:11px;
}

.meta-account-row{
  display:flex; justify-content:space-between; align-items:center;
  padding:10px 12px; background:#fff;
  border:1px solid var(--border); border-radius:10px;
  margin-bottom:8px; font-size:12px;
  gap:10px;
}
.meta-account-row.sold{
  background:#fef2f2; border-color:#fecaca;
}
.meta-account-row .ma-user{ font-weight:800; color:#3730a3; flex:1; word-break:break-all; }
.meta-account-row .ma-pass{ color:#7c3aed; font-family:monospace; font-size:11px; flex:1; word-break:break-all; }
.meta-account-row .ma-status{
  font-size:10px; padding:3px 8px; border-radius:10px; font-weight:700;
}
.meta-account-row .ma-status.available{ background:#dcfce7; color:#15803d; }
.meta-account-row .ma-status.sold{ background:#fee2e2; color:#b91c1c; }

/* RANGE BUILDER */
.range-builder-row{
  display:grid;
  grid-template-columns:1fr 1fr 1fr 0.8fr auto;
  gap:6px;
  margin-bottom:8px;
  align-items:center;
  padding:9px;
  background:#fff;
  border:1.5px solid #dbeafe;
  border-radius:10px;
}
.range-builder-row input{
  padding:8px 9px;
  font-size:12.5px;
  background:#f7f9fc;
  border:1px solid #e2e8f0;
  border-radius:8px;
  width:100%;
  font-family:inherit;
}
.range-builder-row input:focus{
  border-color:var(--primary);
  background:#fff;
}
.range-builder-row .rb-label{
  font-size:9.5px;
  font-weight:800;
  color:#1e40af;
  text-align:center;
  margin-bottom:2px;
  text-transform:uppercase;
  letter-spacing:0.5px;
}
.range-builder-row .rb-del{
  width:34px;height:34px;
  border-radius:9px;
  background:var(--danger-bg);
  color:var(--danger);
  display:flex;align-items:center;justify-content:center;
  font-size:14px;border:none;cursor:pointer;font-family:inherit;
}
@media(max-width:600px){
  .range-builder-row{
    grid-template-columns:1fr 1fr;
    gap:8px;
  }
}
@media(max-width:420px){
  .form-grid-2{ grid-template-columns:1fr; }
}

/* CREDIT ALERT */
.credit-alert{
  background:linear-gradient(135deg,#ecfdf5,#f0fdf4);
  border:1.5px solid #bbf7d0; border-radius:12px;
  padding:12px; margin-top:12px;
  display:flex; gap:10px; align-items:flex-start;
}
.credit-alert .ca-ico{
  width:36px;height:36px;border-radius:10px;
  background:var(--grad-green);
  display:flex;align-items:center;justify-content:center;
  font-size:18px;color:#fff;flex-shrink:0;
}
.credit-alert .ca-content{flex:1;min-width:0;}
.credit-alert .ca-title{font-size:12.5px;font-weight:800;color:#15803d;}
.credit-alert .ca-sub{font-size:11px;color:#166534;margin-top:3px;line-height:1.5;}
</style>
</head>
<body>

<!-- LOGIN -->
<div class="login-screen" id="loginScreen">
  <div class="login-box">
    <div class="login-logo">🔐</div>
    <div class="login-title">Admin Panel</div>
    <div class="login-sub">GBS BD COIN BAY</div>
    <input type="password" id="loginPass" class="login-input" placeholder="পাসওয়ার্ড দিন" autocomplete="off" />
    <div class="login-error" id="loginError">❌ পাসওয়ার্ড ভুল</div>
    <button class="login-btn" onclick="doLogin()">🔓 Login</button>
  </div>
</div>

<!-- ADMIN APP -->
<div id="adminApp">
  <div class="topbar">
    <div class="topbar-title">
      <div class="tico">💎</div>
      <div>Admin Panel</div>
    </div>
    <button class="logout-btn" onclick="doLogout()">Logout ➜</button>
  </div>

  <div class="tabs">
    <button class="tab-btn active" data-tab="dashboard">📊 Dashboard</button>
    <button class="tab-btn" data-tab="orders">📦 Orders</button>
    <button class="tab-btn" data-tab="categories">🗂️ Categories</button>
    <button class="tab-btn" data-tab="shop">🛒 Products</button>
    <button class="tab-btn" data-tab="meta">🎭 Meta Sell</button>
    <button class="tab-btn" data-tab="addmoney">➕ Add Money</button>
    <button class="tab-btn" data-tab="withdraw">💸 Withdraw</button>
    <button class="tab-btn" data-tab="apps">💰 Coin Apps</button>
    <button class="tab-btn" data-tab="payments">💳 Payments</button>
    <button class="tab-btn" data-tab="tutorials">🎥 Tutorials</button>
    <button class="tab-btn" data-tab="reviews">⭐ Reviews</button>
    <button class="tab-btn" data-tab="users">👥 Users</button>
    <button class="tab-btn" data-tab="transactions">💳 Transactions</button>
    <button class="tab-btn" data-tab="settings">⚙️ Settings</button>
  </div>

  <!-- DASHBOARD -->
