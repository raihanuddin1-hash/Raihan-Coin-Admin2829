/* =========================================================
   PAYMENTS
========================================================= */
async function loadPayments(){
  const box = $('paymentsList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('paymentMethods').once('value');
    const data = snap.val() || {};
    PAYMENTS = Object.keys(data).map(k=>({ id:k, ...data[k] }));
    renderPayments();
  }catch(e){}
}
function renderPayments(){
  const box = $('paymentsList');
  if(!PAYMENTS.length){
    box.innerHTML = `<div class="empty"><div class="eico">💳</div><div class="etxt">Method নেই। "⚡ Seed" চাপুন।</div>
      <button class="btn btn-primary btn-icon" onclick="seedPayments()" style="margin-top:14px;">⚡ Seed</button></div>`;
    return;
  }
  box.innerHTML = PAYMENTS.map(p=>{
    const active = p.status !== false;
    const logo = safeUrl(p.logo) || 'https://ui-avatars.com/api/?name='+encodeURIComponent(p.name||'P')+'&background=2f88ff&color=fff';
    return `<div class="card">
      <div class="card-head">
        <div class="card-title">
          <img src="${esc(logo)}" />
          <div class="card-title-text">
            <div class="ct-name">${esc(p.name||'-')}</div>
            <div class="ct-sub">📞 ${esc(p.adminNumber||p.number||'-')}</div>
          </div>
        </div>
        <span class="badge ${active?'badge-active':'badge-stop'}">${active?'Active':'Inactive'}</span>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button class="btn ${active?'btn-danger':'btn-success'} btn-icon" onclick="togglePay('${p.id}', ${active})">${active?'🔴 Disable':'🟢 Enable'}</button>
        <button class="btn btn-primary btn-icon" onclick="editPay('${p.id}')">✏️ Edit</button>
        <button class="btn btn-ghost btn-icon" onclick="deletePay('${p.id}')">🗑 Delete</button>
      </div>
    </div>`;
  }).join('');
}
async function seedPayments(){
  confirmAction('৩টি Default Method যোগ করবেন?', async ()=>{
    try{
      const updates = {};
      Object.keys(DEFAULT_SEED_PAYMENTS).forEach(k=>{ updates['paymentMethods/'+k] = DEFAULT_SEED_PAYMENTS[k]; });
      await db.ref().update(updates);
      toast('Added','ok'); loadPayments();
    }catch(e){ toast('হয়নি','err'); }
  });
}
function openPayModal(){
  $('payModalTitle').textContent = '➕ Add Payment Method';
  $('pay_id').value = '';
  $('pay_name').value = '';
  $('pay_adminNumber').value = '';
  $('pay_number').value = '';
  $('pay_instructions').value = '';
  $('pay_status').checked = true;
  IMG_STORE.pay_logo = '';
  if($('pay_logo_preview')) $('pay_logo_preview').classList.remove('show');
  if($('pay_logo_wrap')) $('pay_logo_wrap').classList.remove('has-image');
  openModal('payModal');
}
function editPay(id){
  const p = PAYMENTS.find(x=>x.id===id);
  if(!p) return;
  $('payModalTitle').textContent = '✏️ Edit Payment';
  $('pay_id').value = p.id;
  $('pay_name').value = p.name || '';
  $('pay_adminNumber').value = p.adminNumber || p.number || '';
  $('pay_number').value = p.number || '';
  $('pay_instructions').value = p.instructions || '';
  $('pay_status').checked = p.status !== false;
  setImagePreview('pay_logo', p.logo || '');
  openModal('payModal');
}
async function savePay(){
  const existingId = ($('pay_id').value || '').trim();
  const id = existingId || ('pay_' + Date.now());
  const name = $('pay_name').value.trim();
  if(!name){ toast('Name দিন','err'); return; }
  const payload = {
    name,
    logo: IMG_STORE.pay_logo || '',
    adminNumber: $('pay_adminNumber').value.trim(),
    number: $('pay_number').value.trim() || $('pay_adminNumber').value.trim(),
    instructions: $('pay_instructions').value.trim(),
    status: $('pay_status').checked,
    updatedAt: Date.now()
  };
  if(!existingId) payload.createdAt = Date.now();
  try{
    if(existingId) await db.ref('paymentMethods/' + id).update(payload);
    else await db.ref('paymentMethods/' + id).set(payload);
    toast('Saved','ok'); closeModal('payModal'); loadPayments();
  }catch(e){ toast('হয়নি','err'); }
}
async function togglePay(id, isActive){
  try{ await db.ref('paymentMethods/'+id).update({ status: !isActive }); loadPayments(); }
  catch(e){ toast('হয়নি','err'); }
}
function deletePay(id){
  confirmAction('Delete?', async ()=>{
    try{ await db.ref('paymentMethods/'+id).remove(); loadPayments(); toast('Deleted','ok'); }
    catch(e){ toast('হয়নি','err'); }
  });
}

/* =========================================================
   TUTORIALS
========================================================= */
async function loadTutorials(){
  const box = $('tutorialsList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('tutorials').once('value');
    const data = snap.val() || {};
    TUTORIALS = Object.keys(data).map(k=>({ id:k, ...data[k] }));
    renderTutorials();
  }catch(e){}
}
function renderTutorials(){
  const box = $('tutorialsList');
  if(!TUTORIALS.length){
    box.innerHTML = '<div class="empty"><div class="eico">🎥</div><div class="etxt">Tutorial নেই।</div></div>';
    return;
  }
  box.innerHTML = TUTORIALS.map(t=>{
    const active = t.status !== false;
    const thumb = safeUrl(t.thumbnail) || 'https://via.placeholder.com/80/f1f5f9/2f88ff?text=T';
    return `<div class="card">
      <div class="card-head">
        <div class="card-title">
          <img src="${esc(thumb)}" />
          <div class="card-title-text">
            <div class="ct-name">${esc(t.title||'-')}</div>
            <div class="ct-sub">${esc((t.videoUrl||'').slice(0,40))}</div>
          </div>
        </div>
        <span class="badge ${active?'badge-active':'badge-stop'}">${active?'Active':'Hidden'}</span>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button class="btn ${active?'btn-danger':'btn-success'} btn-icon" onclick="toggleTut('${t.id}', ${active})">${active?'🔴 Hide':'🟢 Show'}</button>
        <button class="btn btn-primary btn-icon" onclick="editTut('${t.id}')">✏️ Edit</button>
        <button class="btn btn-ghost btn-icon" onclick="deleteTut('${t.id}')">🗑 Delete</button>
      </div>
    </div>`;
  }).join('');
}
function openTutModal(){
  $('tutModalTitle').textContent = '➕ Add Tutorial';
  $('tut_id').value = '';
  $('tut_title').value = '';
  $('tut_videoUrl').value = '';
  $('tut_description').value = '';
  $('tut_status').checked = true;
  IMG_STORE.tut_thumbnail = '';
  if($('tut_thumbnail_preview')) $('tut_thumbnail_preview').classList.remove('show');
  if($('tut_thumbnail_wrap')) $('tut_thumbnail_wrap').classList.remove('has-image');
  openModal('tutModal');
}
function editTut(id){
  const t = TUTORIALS.find(x=>x.id===id);
  if(!t) return;
  $('tutModalTitle').textContent = '✏️ Edit Tutorial';
  $('tut_id').value = t.id;
  $('tut_title').value = t.title || '';
  $('tut_videoUrl').value = t.videoUrl || '';
  $('tut_description').value = t.description || '';
  $('tut_status').checked = t.status !== false;
  setImagePreview('tut_thumbnail', t.thumbnail || '');
  openModal('tutModal');
}
async function saveTut(){
  const existingId = ($('tut_id').value || '').trim();
  const id = existingId || ('tut_' + Date.now());
  const title = $('tut_title').value.trim();
  if(!title){ toast('Title দিন','err'); return; }
  const payload = {
    title,
    thumbnail: IMG_STORE.tut_thumbnail || '',
    videoUrl: $('tut_videoUrl').value.trim(),
    description: $('tut_description').value.trim(),
    status: $('tut_status').checked,
    updatedAt: Date.now()
  };
  if(!existingId) payload.createdAt = Date.now();
  try{
    if(existingId) await db.ref('tutorials/'+id).update(payload);
    else await db.ref('tutorials/'+id).set(payload);
    toast('Saved','ok'); closeModal('tutModal'); loadTutorials();
  }catch(e){ toast('হয়নি','err'); }
}
async function toggleTut(id, isActive){
  try{ await db.ref('tutorials/'+id).update({ status: !isActive }); loadTutorials(); }
  catch(e){ toast('হয়নি','err'); }
}
function deleteTut(id){
  confirmAction('Delete?', async ()=>{
    try{ await db.ref('tutorials/'+id).remove(); loadTutorials(); toast('Deleted','ok'); }
    catch(e){ toast('হয়নি','err'); }
  });
}

/* =========================================================
   REVIEWS
========================================================= */
async function loadReviews(){
  const box = $('reviewsList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('reviews').once('value');
    const data = snap.val() || {};
    REVIEWS = Object.keys(data).map(k=>({ id:k, ...data[k] })).sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
    renderReviews();
  }catch(e){}
}
function renderReviews(){
  const box = $('reviewsList');
  let list = REVIEWS.slice();
  if(REVIEW_FILTER !== 'all') list = list.filter(r=>r.status === REVIEW_FILTER);
  if(!list.length){ box.innerHTML = '<div class="empty"><div class="eico">⭐</div><div class="etxt">Review নেই।</div></div>'; return; }
  box.innerHTML = list.map(r=>{
    const st = r.status || 'pending';
    const stars = '★'.repeat(Math.min(5, Math.max(1, num(r.rating)))) + '☆'.repeat(5 - Math.min(5, Math.max(1, num(r.rating))));
    const av = safeUrl(r.photoUrl) || 'https://ui-avatars.com/api/?name='+encodeURIComponent(r.firstName||'U')+'&background=2f88ff&color=fff';
    return `<div class="card">
      <div class="card-head">
        <div class="card-title">
          <img src="${esc(av)}" />
          <div class="card-title-text">
            <div class="ct-name">${esc(r.firstName||('@'+(r.username||'user')))}</div>
            <div class="ct-sub">${stars} • @${esc(r.username||'user')}</div>
          </div>
        </div>
        <span class="badge badge-${st==='approved'?'completed':st==='rejected'?'rejected':'pending'}">${st.toUpperCase()}</span>
      </div>
      <div style="font-size:13px;color:#4a5875;line-height:1.6;margin-bottom:12px;">${esc(r.review||'')}</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        ${st!=='approved'?`<button class="btn btn-success btn-icon" onclick="approveReview('${r.id}')">✅ Approve</button>`:''}
        ${st!=='rejected'?`<button class="btn btn-danger btn-icon" onclick="rejectReview('${r.id}')">❌ Reject</button>`:''}
        <button class="btn btn-ghost btn-icon" onclick="deleteReview('${r.id}')">🗑 Delete</button>
      </div>
    </div>`;
  }).join('');
}
document.querySelectorAll('#reviewFilters .filter-chip').forEach(c=>{
  c.addEventListener('click', ()=>{
    document.querySelectorAll('#reviewFilters .filter-chip').forEach(x=>x.classList.remove('active'));
    c.classList.add('active');
    REVIEW_FILTER = c.getAttribute('data-rstatus');
    renderReviews();
  });
});
async function approveReview(id){
  try{ await db.ref('reviews/'+id).update({ status:'approved' }); loadReviews(); toast('Approved','ok'); }
  catch(e){ toast('হয়নি','err'); }
}
async function rejectReview(id){
  try{ await db.ref('reviews/'+id).update({ status:'rejected' }); loadReviews(); toast('Rejected','ok'); }
  catch(e){ toast('হয়নি','err'); }
}
function deleteReview(id){
  confirmAction('Delete?', async ()=>{
    try{ await db.ref('reviews/'+id).remove(); loadReviews(); toast('Deleted','ok'); }
    catch(e){ toast('হয়নি','err'); }
  });
}

/* =========================================================
   USERS
========================================================= */
async function loadUsers(){
  const box = $('usersList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('users').once('value');
    const data = snap.val() || {};
    USERS = Object.keys(data).map(k=>({ id:k, ...data[k] })).sort((a,b)=>(b.joinedAt||0)-(a.joinedAt||0));
    renderUsers();
  }catch(e){}
}
function renderUsers(){
  const search = ($('userSearch').value || '').toLowerCase().trim();
  const box = $('usersList');
  let list = USERS.slice();
  if(search) list = list.filter(u=>{
    return String(u.telegramId||'').toLowerCase().includes(search)
      || (u.username||'').toLowerCase().includes(search)
      || (u.firstName||'').toLowerCase().includes(search);
  });
  if(!list.length){ box.innerHTML = '<div class="empty"><div class="eico">👥</div><div class="etxt">User নেই।</div></div>'; return; }
  box.innerHTML = list.map(u=>{
    const blocked = u.status === 'blocked';
    const av = safeUrl(u.photoUrl) || 'https://ui-avatars.com/api/?name='+encodeURIComponent(u.firstName||'U')+'&background=2f88ff&color=fff';
    const safeName = String((u.firstName||'User')).replace(/'/g, '');
    return `<div class="card">
      <div class="card-head">
        <div class="card-title">
          <img src="${esc(av)}" />
          <div class="card-title-text">
            <div class="ct-name">${esc((u.firstName||'')+' '+(u.lastName||'')).trim() || 'User'}</div>
            <div class="ct-sub">@${esc(u.username||'user')} • ID: ${esc(u.telegramId||'-')} • 💰 ৳${fmtD(u.balance||0)}</div>
          </div>
        </div>
        <span class="badge ${blocked?'badge-rejected':'badge-active'}">${blocked?'Blocked':'Active'}</span>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button class="btn btn-purple btn-icon" onclick="openBalanceModal('${u.id}', '${safeName}', ${num(u.balance||0)})">💰 Balance</button>
        <button class="btn ${blocked?'btn-success':'btn-danger'} btn-icon" onclick="toggleBlock('${u.id}', ${blocked})">${blocked?'🟢 Unblock':'🔴 Block'}</button>
      </div>
    </div>`;
  }).join('');
}
$('userSearch').addEventListener('input', renderUsers);
async function toggleBlock(id, blocked){
  try{
    await db.ref('users/' + id).update({ status: blocked ? 'active' : 'blocked' });
    toast(blocked ? 'Unblocked' : 'Blocked','ok');
    loadUsers();
  }catch(e){ toast('হয়নি','err'); }
}
function openBalanceModal(userId, userName, currentBalance){
  $('bal_userId').value = userId;
  $('bal_userName').value = userName + ' (#' + userId + ')';
  $('bal_current').value = '৳' + fmtD(currentBalance);
  $('bal_action').value = 'add';
  $('bal_amount').value = '';
  $('bal_note').value = '';
  openModal('balanceModal');
}
async function submitBalanceAdjust(){
  const userId = $('bal_userId').value;
  const action = $('bal_action').value;
  const amount = num($('bal_amount').value);
  const note = $('bal_note').value.trim();
  if(!userId){ toast('User নেই','err'); return; }
  if(!amount || amount <= 0){ toast('Amount দিন','err'); return; }
  try{
    const snap = await db.ref('users/' + userId + '/balance').once('value');
    const curr = num(snap.val()) || 0;
    let newBal = curr;
    if(action === 'add') newBal = curr + amount;
    else if(action === 'subtract') newBal = Math.max(0, curr - amount);
    else if(action === 'set') newBal = amount;
    await db.ref('users/' + userId + '/balance').set(newBal);
    const trxId = 'ADJ-' + Date.now().toString().slice(-8);
    await db.ref('transactions/' + trxId).set({
      trxId, telegramId: userId,
      type: action === 'subtract' ? 'withdraw' : 'add',
      label: 'Admin Adjustment' + (note ? ' • ' + note : ''),
      amount: amount, status: 'completed', createdAt: Date.now()
    });
    toast('Balance Updated: ৳'+fmtD(newBal),'ok');
    closeModal('balanceModal');
    loadUsers();
  }catch(e){ toast('হয়নি','err'); }
}

/* =========================================================
   TRANSACTIONS
========================================================= */
async function loadAllTransactions(){
  const box = $('transactionsList');
  box.innerHTML = '<div class="sk sk-block"></div>';
  try{
    const snap = await db.ref('transactions').once('value');
    const data = snap.val() || {};
    ALL_TRANSACTIONS = Object.keys(data).map(k=>({ id:k, ...data[k] })).sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
    renderTransactions();
  }catch(e){}
}
function renderTransactions(){
  const box = $('transactionsList');
  let list = ALL_TRANSACTIONS.slice();
  if(TRX_FILTER !== 'all') list = list.filter(t=>t.type === TRX_FILTER);
  if(!list.length){ box.innerHTML = '<div class="empty"><div class="eico">💳</div><div class="etxt">Transaction নেই।</div></div>'; return; }
  box.innerHTML = list.slice(0,100).map(t=>{
    const dt = t.createdAt ? new Date(t.createdAt).toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) : '';
    const icons = { add:'➕', withdraw:'💸', shop:'🛒', meta:'🎭' };
    return `<div class="order-item">
      <div class="order-item-top">
        <div>
          <div class="order-item-id">#${esc(t.trxId||t.id)}</div>
          <div class="order-item-sub">${icons[t.type]||'💳'} ${esc(t.label||t.type||'-')} • ${esc(dt)}</div>
        </div>
        <span class="badge ${statusClass(t.status)}">${statusLabel(t.status)}</span>
      </div>
      <div style="display:flex;justify-content:space-between;margin-top:8px;padding-top:8px;border-top:1px dashed var(--border);">
        <div style="font-size:11.5px;color:var(--muted);">@${esc(t.username||'-')} (${esc(t.telegramId||'-')})</div>
        <div style="font-size:15px;font-weight:900;color:#22c55e;">৳${fmtD(t.amount)}</div>
      </div>
    </div>`;
  }).join('');
}
document.querySelectorAll('#trxFilters .filter-chip').forEach(c=>{
  c.addEventListener('click', ()=>{
    document.querySelectorAll('#trxFilters .filter-chip').forEach(x=>x.classList.remove('active'));
    c.classList.add('active');
    TRX_FILTER = c.getAttribute('data-ttype');
    renderTransactions();
  });
});

/* =========================================================
   SETTINGS
========================================================= */
async function loadSettingsForm(){
  try{
    const snap = await db.ref('settings').once('value');
    SETTINGS = snap.val() || {};
  }catch(e){ SETTINGS = {}; }
  $('s_appName').value = SETTINGS.appName || 'GBS BD COIN BAY';
  $('s_tagline').value = SETTINGS.tagline || 'Coin Sell • Fast Payment';
  $('s_supportChannelUrl').value = SETTINGS.supportChannelUrl || '';
  $('s_joinBtnText').value = SETTINGS.joinBtnText || 'Join Official Channel';
  $('s_sendMoneyFee').value = SETTINGS.sendMoneyFee || 5;
  $('s_metaDefaultPrice').value = SETTINGS.metaDefaultPrice || 0.50;
  $('s_notice').value = SETTINGS.notice || '';
  $('s_contactInfo').value = SETTINGS.contactInfo || '';
  $('s_footerText').value = SETTINGS.footerText || '💎 GBS BD COIN BAY • v1.0';
  $('s_maintenanceMode').checked = SETTINGS.maintenanceMode === true;
  $('s_maintenanceText').value = SETTINGS.maintenanceText || 'বর্তমানে আপডেট করা হচ্ছে।';
  setImagePreview('s_logo', SETTINGS.logo || '');
  setImagePreview('s_splashImage', SETTINGS.splashImage || '');
}
async function saveSettings(){
  const payload = {
    appName: $('s_appName').value.trim(),
    tagline: $('s_tagline').value.trim(),
    logo: IMG_STORE.s_logo || '',
    splashImage: IMG_STORE.s_splashImage || '',
    supportChannelUrl: $('s_supportChannelUrl').value.trim(),
    joinBtnText: $('s_joinBtnText').value.trim(),
    sendMoneyFee: num($('s_sendMoneyFee').value) || 5,
    metaDefaultPrice: num($('s_metaDefaultPrice').value) || 0.50,
    notice: $('s_notice').value.trim(),
    noticeEnabled: true,
    contactInfo: $('s_contactInfo').value.trim(),
    footerText: $('s_footerText').value.trim(),
    maintenanceMode: $('s_maintenanceMode').checked,
    maintenanceText: $('s_maintenanceText').value.trim()
  };
  try{
    await db.ref('settings').update(payload);
    toast('Settings Saved','ok');
  }catch(e){ toast('Save হয়নি','err'); }
}

/* =========================================================
   MODAL CLOSE
========================================================= */
document.querySelectorAll('.modal').forEach(m=>{
  m.addEventListener('click', e=>{ if(e.target === m) m.classList.remove('show'); });
});

/* =========================================================
   BOOT
========================================================= */
function bootAdmin(){
  loadDashboard();
  loadSettingsForm();
}
(function checkAutoLogin(){
  try{
    if(sessionStorage.getItem('gbs_admin_ok') === '1'){
      $('loginScreen').style.display = 'none';
      $('adminApp').classList.add('active');
      bootAdmin();
    } else {
      setTimeout(()=>{ try{ $('loginPass').focus(); }catch(e){} }, 200);
    }
  }catch(e){}
})();
</script>
</body>
</html>