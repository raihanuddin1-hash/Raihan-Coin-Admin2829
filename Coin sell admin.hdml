  nagad: { name:'নগদ', logo:'https://i.ibb.co/99VKJ35z/file-67.jpg', number:'01XXXXXXXXX', adminNumber:'01XXXXXXXXX', status:true, createdAt:Date.now() },
  rocket: { name:'রকেট', logo:'https://i.ibb.co/jZB1xVJz/file-65.jpg', number:'01XXXXXXXXX', adminNumber:'01XXXXXXXXX', status:true, createdAt:Date.now() }
};

const ICON_MAP = {
